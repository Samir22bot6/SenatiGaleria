---
import Layout from '../layouts/Layout.astro';
import LoginForm from '../components/LoginForm.astro';
---

<Layout title="Acceso | SENATI Event Live Gallery">
  <div class="flex-1 flex flex-col justify-center items-center py-10 px-4 sm:px-6 relative overflow-hidden bg-gradient-to-b from-[#F1F5F9] via-white to-[#E2E8F0]">
    <!-- Background subtle geometric accents -->
    <div class="absolute -top-32 -left-32 w-96 h-96 rounded-full bg-[#00A3E0]/10 blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-96 h-96 rounded-full bg-[#7C3AED]/10 blur-3xl pointer-events-none"></div>
    
    <!-- Institutional Welcome Banner -->
    <div class="text-center max-w-xl mb-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#002855]/10 text-[#002855] text-xs font-bold uppercase tracking-wider mb-3">
        <span class="w-2 h-2 rounded-full bg-[#00A3E0] animate-ping"></span>
        Evento Oficial SENATI 2026
      </div>
      <h1 class="text-3xl sm:text-4xl font-heading font-black text-[#002855] tracking-tight">
        Galería en Vivo y Proyección
      </h1>
      <p class="text-sm sm:text-base text-slate-600 mt-2 font-normal">
        Sube tus fotos desde tu celular y sé parte de la transmisión en tiempo real en la pantalla gigante.
      </p>
    </div>

    <!-- Login Form Centralizado -->
    <LoginForm />

    <!-- Footer info -->
    <footer class="mt-12 text-center text-xs text-slate-400">
      <p>© 2026 Servicio Nacional de Adiestramiento en Trabajo Industrial (SENATI).</p>
      <p class="mt-1 text-[11px]">Diseñado para eventos presenciales, ferias tecnológicas y graduaciones.</p>
    </footer>
  </div>
</Layout>
