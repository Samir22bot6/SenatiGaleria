---
import Layout from '../layouts/Layout.astro';
import LoginForm from '../components/LoginForm.astro';
---

<Layout title="Iniciar Sesión | SENATI Event Live Gallery">
  <div class="flex-1 flex flex-col justify-center items-center py-10 px-4 sm:px-6 relative overflow-hidden bg-gradient-to-b from-[#F1F5F9] via-white to-[#E2E8F0]">
    <div class="absolute -top-32 -left-32 w-96 h-96 rounded-full bg-[#00A3E0]/10 blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-96 h-96 rounded-full bg-[#7C3AED]/10 blur-3xl pointer-events-none"></div>
    
    <LoginForm />

    <footer class="mt-12 text-center text-xs text-slate-400">
      <p>© 2026 SENATI - Transmisión de Eventos en Vivo</p>
    </footer>
  </div>
</Layout>
