---
// PhotoUploader.astro — Estudio de Captura y Subida SENATI con Cámara Pro y Recortador de Video (8s)
---

<div class="w-full bg-white rounded-3xl p-4 sm:p-7 shadow-xl shadow-slate-200/50 border border-slate-100">
  <!-- Encabezado -->
  <div class="flex items-center justify-between mb-5 pb-3.5 border-b border-slate-100 gap-2">
    <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
      <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-2xl bg-[#00A3E0]/15 text-[#002855] flex items-center justify-center shadow-sm shrink-0">
        <svg class="w-5 h-5 sm:w-6 sm:h-6 text-[#00A3E0]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
      </div>
      <div class="min-w-0">
        <h3 class="font-heading font-black text-lg sm:text-2xl text-[#002855] truncate">Estudio de Captura y Subida</h3>
        <p class="text-[11px] sm:text-sm text-slate-500 font-medium truncate sm:whitespace-normal">Fotos en alta definición y videos cortos (máx 8s) con recortador</p>
      </div>
    </div>
    <span class="inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-1 rounded-full text-[10px] sm:text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 shadow-xs shrink-0">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span class="hidden sm:inline">Transmisión Activa</span>
      <span class="sm:hidden">En Vivo</span>
    </span>
  </div>

  <!-- Botones de Acción Inicial (Cámara Pro vs Galería) -->
  <div id="upload-methods-container" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <!-- Opción 1: Cámara Pro en Vivo -->
    <button 
      type="button" 
      id="btn-open-camera"
      class="group p-6 rounded-2xl border-2 border-dashed border-[#00A3E0] hover:border-[#002855] bg-gradient-to-br from-sky-50/70 to-blue-50/30 hover:from-sky-100/60 hover:to-blue-100/40 flex flex-col items-center justify-center gap-3.5 transition-all cursor-pointer shadow-sm hover:shadow-md"
    >
      <div class="relative w-16 h-16 rounded-2xl bg-gradient-to-tr from-[#004B93] to-[#00A3E0] text-white flex items-center justify-center shadow-lg shadow-sky-500/25 group-hover:scale-105 transition-transform">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
        </svg>
        <span class="absolute -top-1 -right-1 w-3.5 h-3.5 rounded-full bg-emerald-400 border-2 border-white"></span>
      </div>
      <div class="text-center">
        <span class="font-heading font-black text-[#002855] text-base sm:text-lg block group-hover:text-[#00A3E0] transition-colors">
          Cámara en Vivo Pro
        </span>
        <span class="text-xs text-slate-500 font-medium">Fotos en HD o clips de 8s con cambio de lente frontal/trasera</span>
      </div>
    </button>

    <!-- Opción 2: Subir desde Galería (Con soporte de recorte) -->
    <label 
      for="file-gallery-input"
      class="group p-6 rounded-2xl border-2 border-dashed border-slate-300 hover:border-[#7C3AED] bg-gradient-to-br from-slate-50/70 to-purple-50/20 hover:from-purple-50/60 hover:to-indigo-50/40 flex flex-col items-center justify-center gap-3.5 transition-all cursor-pointer shadow-sm hover:shadow-md"
    >
      <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-[#6D28D9] to-[#9333EA] text-white flex items-center justify-center shadow-lg shadow-purple-500/25 group-hover:scale-105 transition-transform">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
      </div>
      <div class="text-center">
        <span class="font-heading font-black text-slate-800 text-base sm:text-lg block group-hover:text-[#7C3AED] transition-colors">
          Subir Foto o Video
        </span>
        <span class="text-xs text-slate-500 font-medium">JPG, PNG o videos (si duran más de 8s podrás recortarlos)</span>
      </div>
      <input 
        type="file" 
        id="file-gallery-input" 
        accept="image/*,video/mp4,video/webm,video/quicktime,video/mov,video/*" 
        class="hidden"
      />
    </label>
  </div>

  <!-- Inputs nativos con clase sr-only para no ser descartados por el navegador en segundo plano -->
  <input 
    type="file" 
    id="camera-photo-input" 
    accept="image/*" 
    capture="environment" 
    class="sr-only" 
    tabindex="-1"
    aria-hidden="true"
  />

  <input 
    type="file" 
    id="camera-video-input" 
    accept="video/*" 
    capture="environment" 
    class="sr-only" 
    tabindex="-1"
    aria-hidden="true"
  />

  <input 
    type="file" 
    id="camera-fallback-input" 
    accept="image/*,video/*" 
    capture="environment" 
    class="sr-only" 
    tabindex="-1"
    aria-hidden="true"
  />

  <!-- ═════════════════════════════════════════════════════════════════  <div 
    id="camera-mode-modal" 
    class="hidden fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-slate-950/85 backdrop-blur-md transition-all duration-200"
    role="dialog"
    aria-modal="true"
    aria-labelledby="camera-modal-title"
  >
    <div class="relative w-full max-w-sm sm:max-w-md bg-gradient-to-b from-[#001736] via-[#051126] to-[#000d1f] rounded-3xl p-4 sm:p-7 border border-cyan-500/40 shadow-[0_0_50px_rgba(0,163,224,0.3)] text-white">
      
      <!-- Botón Cerrar -->
      <button 
        type="button" 
        id="btn-close-mode-modal" 
        class="absolute top-3.5 right-3.5 sm:top-4 sm:right-4 w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-white/10 hover:bg-white/20 text-white/70 hover:text-white flex items-center justify-center transition-all cursor-pointer border border-white/10 text-xs sm:text-sm font-bold"
        aria-label="Cerrar modal"
      >
        ✕
      </button>

      <!-- Encabezado del selector -->
      <div class="text-center mb-4 sm:mb-6 px-2">
        <div class="inline-flex items-center justify-center w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-gradient-to-tr from-[#00A3E0] to-[#004B93] text-white shadow-lg shadow-cyan-500/30 mb-2 sm:mb-3 border border-cyan-300/30">
          <svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
        </div>
        <h3 id="camera-modal-title" class="font-heading font-black text-lg sm:text-xl text-white">
          Cámara en Vivo SENATI TEC
        </h3>
        <p class="text-[11px] sm:text-xs text-cyan-200/80 mt-0.5 sm:mt-1 leading-snug">
          Elige qué deseas capturar para la pantalla gigante del evento
        </p>
      </div>

      <!-- Opciones Principales de Captura -->
      <div class="space-y-2.5 sm:space-y-3.5">
        <!-- Opción 1: FOTO NATIVA -->
        <button 
          type="button" 
          id="btn-select-mode-photo"
          class="w-full group p-3 sm:p-4 rounded-2xl bg-gradient-to-r from-sky-500/10 to-blue-500/10 hover:from-sky-500/20 hover:to-blue-500/20 border-2 border-cyan-500/30 hover:border-cyan-400 active:scale-98 transition-all flex items-center gap-3 sm:gap-4 text-left cursor-pointer shadow-sm hover:shadow-[0_0_20px_rgba(0,163,224,0.3)]"
        >
          <div class="w-11 h-11 sm:w-13 sm:h-13 rounded-2xl bg-gradient-to-tr from-cyan-600 to-sky-400 text-white flex items-center justify-center shrink-0 shadow-md shadow-cyan-500/25 group-hover:scale-105 transition-transform">
            <svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex flex-wrap items-center justify-between gap-1">
              <span class="font-heading font-black text-sm sm:text-base text-white group-hover:text-cyan-300 transition-colors">
                📸 Tomar Fotografía
              </span>
              <span class="text-[9px] sm:text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 shrink-0">
                HD Nitidez
              </span>
            </div>
            <p class="text-[11px] sm:text-xs text-slate-300 mt-0.5 leading-snug">
              Abre la cámara de tu teléfono en modo foto
            </p>
          </div>
        </button>

        <!-- Opción 2: VIDEO NATIVO (8s) -->
        <button 
          type="button" 
          id="btn-select-mode-video"
          class="w-full group p-3 sm:p-4 rounded-2xl bg-gradient-to-r from-red-500/10 to-rose-500/10 hover:from-red-500/20 hover:to-rose-500/20 border-2 border-red-500/30 hover:border-red-400 active:scale-98 transition-all flex items-center gap-3 sm:gap-4 text-left cursor-pointer shadow-sm hover:shadow-[0_0_20px_rgba(239,68,68,0.3)]"
        >
          <div class="w-11 h-11 sm:w-13 sm:h-13 rounded-2xl bg-gradient-to-tr from-red-600 to-rose-400 text-white flex items-center justify-center shrink-0 shadow-md shadow-red-500/25 group-hover:scale-105 transition-transform">
            <svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex flex-wrap items-center justify-between gap-1">
              <span class="font-heading font-black text-sm sm:text-base text-white group-hover:text-red-300 transition-colors">
                🎥 Grabar Video Corto
              </span>
              <span class="text-[9px] sm:text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-red-500/20 text-red-300 border border-red-500/30 shrink-0">
                Máx 8s
              </span>
            </div>
            <p class="text-[11px] sm:text-xs text-slate-300 mt-0.5 leading-snug">
              Abre la cámara de tu teléfono en modo video
            </p>
          </div>
        </button>

        <!-- Opción 3: Visor Web con Filtros y Efectos -->
        <button 
          type="button" 
          id="btn-select-mode-webcam"
          class="w-full group p-3 sm:p-3.5 rounded-2xl bg-white/5 hover:bg-white/10 border border-purple-500/30 hover:border-purple-400 active:scale-98 transition-all flex items-center gap-3 text-left cursor-pointer"
        >
          <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-purple-500/20 text-purple-300 flex items-center justify-center shrink-0 border border-purple-500/30">
            <span class="text-base sm:text-lg">✨</span>
          </div>
          <div class="flex-1 min-w-0">
            <span class="font-heading font-bold text-xs sm:text-sm text-purple-200 group-hover:text-purple-100 block">
              Visor en Pantalla con Filtros
            </span>
            <span class="text-[10px] sm:text-[11px] text-slate-400 block leading-snug">
              Efectos SENATI TEC, temporizador y encuadre
            </span>
          </div>
        </button>
      </div>

      <!-- Pie del modal -->
      <div class="mt-4 pt-3 border-t border-white/10 flex justify-center">
        <button 
          type="button" 
          id="btn-cancel-mode-modal"
          class="text-xs sm:text-sm font-bold text-slate-400 hover:text-white px-5 py-2 rounded-xl hover:bg-white/10 transition-colors cursor-pointer"
        >
          Cancelar
        </button>
      </div>
    </div>
  </div>

    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════
       CÁMARA PRO CINEMATOGRÁFICA EN VIVO
  ═══════════════════════════════════════════════════════════════════ -->
  <div id="camera-modal" class="hidden mt-6 bg-gradient-to-b from-[#001736] via-[#051126] to-black rounded-3xl p-4 sm:p-7 border border-cyan-500/40 shadow-2xl relative overflow-hidden transition-all duration-300">
    
    <!-- Barra Superior de la Cámara -->
    <div class="flex items-center justify-between mb-3 text-white">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-pulse"></span>
        <span class="text-xs sm:text-sm font-black font-heading tracking-wide uppercase text-cyan-200">Visor SENATI PRO</span>
        <span id="camera-res-badge" class="text-[10px] px-2.5 py-0.5 rounded-full bg-cyan-500/20 text-cyan-300 font-mono border border-cyan-500/30">HD 60 FPS</span>
      </div>
      
      <div class="flex items-center gap-2">
        <!-- Temporizador 0s / 3s -->
        <button 
          type="button" 
          id="btn-camera-timer" 
          class="flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-white/10 hover:bg-white/20 active:scale-95 text-white text-xs font-bold transition-all cursor-pointer border border-white/15"
          title="Temporizador de disparo"
        >
          <span id="camera-timer-icon">⏱️</span>
          <span id="camera-timer-label">0s</span>
        </button>

        <!-- Alternar Cámara Frontal / Trasera -->
        <button 
          type="button" 
          id="btn-flip-camera" 
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/10 hover:bg-white/20 active:scale-95 text-white text-xs font-bold transition-all cursor-pointer border border-white/15"
          title="Cambiar entre cámara trasera y frontal"
        >
          <svg class="w-4 h-4 text-cyan-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
          </svg>
          <span class="hidden sm:inline">Girar Lente</span>
        </button>

        <!-- Cerrar Cámara -->
        <button 
          type="button" 
          id="btn-close-camera" 
          class="p-1.5 sm:px-3 sm:py-1.5 rounded-xl bg-red-500/20 hover:bg-red-500/30 text-red-300 hover:text-white text-xs font-bold transition-all cursor-pointer border border-red-500/30"
        >
          ✕ Cancelar
        </button>
      </div>
    </div>

    <!-- Visor de Cámara con Guías de Encuadre y Aspect Ratio Dinámico -->
    <div id="camera-viewport-wrapper" class="relative w-full max-w-3xl mx-auto rounded-2xl overflow-hidden shadow-[0_0_60px_rgba(0,163,224,0.25)] border-2 border-cyan-400/50 bg-black flex items-center justify-center transition-all duration-300 aspect-[4/3] sm:aspect-video min-h-[300px]">
      
      <video id="camera-video-feed" autoplay playsinline muted class="w-full h-full object-cover transform scale-x-1 transition-all duration-300"></video>
      <canvas id="camera-capture-canvas" class="hidden"></canvas>

      <!-- Destello de Obturador (Flash visual al tomar foto) -->
      <div id="camera-shutter-flash" class="absolute inset-0 bg-white opacity-0 pointer-events-none transition-opacity duration-150 z-30"></div>

      <!-- Cuenta regresiva visual (3, 2, 1) para el temporizador -->
      <div id="camera-countdown-big" class="hidden absolute inset-0 z-40 bg-black/50 backdrop-blur-xs flex items-center justify-center">
        <span id="camera-countdown-number" class="text-7xl sm:text-8xl font-heading font-black text-white drop-shadow-[0_0_30px_rgba(0,163,224,1)] animate-bounce">3</span>
      </div>

      <!-- Guías de Encuadre en las 4 esquinas (Corner brackets) -->
      <div class="absolute inset-4 pointer-events-none z-10 flex flex-col justify-between">
        <div class="flex justify-between">
          <div class="w-7 h-7 border-t-2 border-l-2 border-cyan-400 rounded-tl-lg shadow-[0_0_10px_rgba(0,163,224,0.5)]"></div>
          <div class="w-7 h-7 border-t-2 border-r-2 border-cyan-400 rounded-tr-lg shadow-[0_0_10px_rgba(0,163,224,0.5)]"></div>
        </div>
        <div class="flex justify-between">
          <div class="w-7 h-7 border-b-2 border-l-2 border-cyan-400 rounded-bl-lg shadow-[0_0_10px_rgba(0,163,224,0.5)]"></div>
          <div class="w-7 h-7 border-b-2 border-r-2 border-cyan-400 rounded-br-lg shadow-[0_0_10px_rgba(0,163,224,0.5)]"></div>
        </div>
      </div>

      <!-- Cuadrícula sutil de tercios fotográficos -->
      <div class="absolute inset-0 pointer-events-none z-10 grid grid-cols-3 grid-rows-3 opacity-25">
        <div class="border-r border-b border-white/80"></div>
        <div class="border-r border-b border-white/80"></div>
        <div class="border-b border-white/80"></div>
        <div class="border-r border-b border-white/80"></div>
        <div class="border-r border-b border-white/80"></div>
        <div class="border-b border-white/80"></div>
        <div class="border-r border-white/80"></div>
        <div class="border-r border-white/80"></div>
        <div></div>
      </div>

      <!-- Barra de Progreso de Grabación de Video de 8 Segundos -->
      <div id="countdown-overlay" class="hidden absolute top-4 left-4 right-4 z-20 flex items-center justify-between bg-black/80 backdrop-blur-md px-4 py-2.5 rounded-2xl border border-red-500/50 shadow-xl">
        <div class="flex items-center gap-2 text-red-400 font-bold text-xs">
          <span class="w-3 h-3 rounded-full bg-red-500 animate-ping"></span>
          <span class="font-mono tracking-wider">GRABANDO HD</span>
        </div>
        <div class="flex-1 mx-4 bg-white/20 h-2.5 rounded-full overflow-hidden">
          <div id="video-record-progress-bar" class="h-full bg-gradient-to-r from-amber-400 to-red-500 transition-all duration-100 ease-linear shadow-[0_0_10px_rgba(239,68,68,0.8)]" style="width: 100%;"></div>
        </div>
        <span class="text-white font-mono font-black text-sm"><strong id="countdown-seconds">8.0</strong>s</span>
      </div>
    </div>

    <!-- Barra de Filtros en Vivo (Embellecedor / Estilos) -->
    <div class="mt-4 flex items-center justify-center gap-2 overflow-x-auto pb-1 max-w-xl mx-auto">
      <span class="text-[11px] font-bold text-white/50 uppercase tracking-wider mr-1 hidden sm:inline">Efecto:</span>
      <button type="button" data-filter="normal" class="cam-filter-btn px-3 py-1 rounded-xl text-xs font-bold transition-all cursor-pointer bg-cyan-500 text-white shadow-xs">
        Natural
      </button>
      <button type="button" data-filter="senati" class="cam-filter-btn px-3 py-1 rounded-xl text-xs font-bold transition-all cursor-pointer bg-white/10 text-white/80 hover:bg-white/20">
        ✨ SENATI Glow
      </button>
      <button type="button" data-filter="warm" class="cam-filter-btn px-3 py-1 rounded-xl text-xs font-bold transition-all cursor-pointer bg-white/10 text-white/80 hover:bg-white/20">
        ☀️ Cálido
      </button>
      <button type="button" data-filter="bw" class="cam-filter-btn px-3 py-1 rounded-xl text-xs font-bold transition-all cursor-pointer bg-white/10 text-white/80 hover:bg-white/20">
        🖤 Noir B&N
      </button>
    </div>

    <!-- Selector de Modo (FOTO vs VIDEO 8s) y Disparador Central -->
    <div class="mt-4 flex flex-col items-center gap-3.5">
      
      <!-- Pestañas de modo estilo cámara profesional -->
      <div class="flex items-center bg-white/10 p-1.5 rounded-2xl border border-white/15 shadow-inner">
        <button 
          type="button" 
          id="mode-tab-photo" 
          class="px-6 py-2 rounded-xl text-xs font-black uppercase tracking-wider transition-all cursor-pointer bg-cyan-500 text-white shadow-md flex items-center gap-1.5"
        >
          <span>📸</span>
          <span>Foto</span>
        </button>
        <button 
          type="button" 
          id="mode-tab-video" 
          class="px-6 py-2 rounded-xl text-xs font-black uppercase tracking-wider transition-all cursor-pointer text-white/70 hover:text-white flex items-center gap-1.5"
        >
          <span>🎥</span>
          <span>Video (8s)</span>
        </button>
      </div>

      <!-- Disparador Central Grande (Shutter Button) -->
      <div class="flex items-center justify-center my-1">
        <!-- Botón Disparador de FOTO -->
        <button 
          type="button" 
          id="btn-shutter-photo" 
          class="group relative w-20 h-20 rounded-full border-4 border-white flex items-center justify-center active:scale-95 transition-all cursor-pointer shadow-[0_0_30px_rgba(255,255,255,0.5)] hover:border-cyan-300"
          title="Tomar fotografía en alta definición"
        >
          <div class="w-15 h-15 rounded-full bg-white group-hover:scale-95 group-active:scale-90 transition-transform shadow-inner"></div>
        </button>

        <!-- Botón Disparador de VIDEO (8s) -->
        <button 
          type="button" 
          id="btn-shutter-video" 
          class="hidden group relative w-20 h-20 rounded-full border-4 border-red-500 flex items-center justify-center active:scale-95 transition-all cursor-pointer shadow-[0_0_35px_rgba(239,68,68,0.6)]"
          title="Iniciar o detener grabación de 8 segundos"
        >
          <div id="video-shutter-inner" class="w-15 h-15 rounded-full bg-red-600 transition-all group-hover:scale-95"></div>
        </button>
      </div>
      <p id="camera-shutter-hint" class="text-xs text-cyan-200/80 font-medium">Toca para capturar tu mejor fotografía</p>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════
       PREVISUALIZACIÓN Y RECORTADOR DE VIDEO INTEGRADO (8s)
  ═══════════════════════════════════════════════════════════════════ -->
  <div id="preview-panel" class="hidden mt-6 bg-slate-50 border border-slate-200 rounded-3xl p-5 sm:p-7 shadow-sm">
    <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-200">
      <h4 class="font-heading font-black text-slate-800 text-base flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-cyan-500"></span>
        <span id="preview-title">Vista Previa</span>
      </h4>
      <button id="btn-discard-preview" class="text-xs text-red-600 hover:text-red-700 font-bold cursor-pointer px-3 py-1.5 rounded-xl hover:bg-red-50 border border-transparent hover:border-red-200 transition-all">
        ✕ Cambiar archivo
      </button>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      
      <!-- Visor de la Foto o Video -->
      <div class="lg:col-span-7 relative w-full aspect-video rounded-2xl overflow-hidden shadow-lg bg-black border border-slate-300 flex items-center justify-center">
        <img id="preview-image-element" src="" alt="Vista previa" class="w-full h-full object-contain" />
        <video id="preview-video-element" src="" controls playsinline class="w-full h-full object-contain hidden"></video>

        <!-- Indicador de video recortado -->
        <div id="badge-trimmed-ok" class="hidden absolute top-3 left-3 bg-emerald-600 text-white font-bold text-[10px] px-2.5 py-1 rounded-full shadow-lg flex items-center gap-1.5">
          <span>✓</span>
          <span id="badge-trimmed-text">Clip ajustado a 8 segundos</span>
        </div>
      </div>

      <!-- Controles, Recortador de Video y Envío -->
      <div class="lg:col-span-5 space-y-4">

        <!-- MÓDULO RECORTADOR DE VIDEO (Visible cuando es video) -->
        <div id="video-trimmer-box" class="hidden bg-white p-4 sm:p-5 rounded-2xl border-2 border-purple-200 shadow-sm space-y-3.5">
          <div class="flex items-center justify-between">
            <span class="text-xs font-black uppercase text-[#6D28D9] flex items-center gap-1.5">
              <span>✂️</span>
              <span>Recortador de Video (Máx 8s)</span>
            </span>
            <span id="trimmer-badge-original-time" class="text-[10px] bg-purple-100 text-[#6D28D9] font-bold px-2 py-0.5 rounded-full">
              Duración: --s
            </span>
          </div>

          <!-- Mensaje dinámico de advertencia si dura más de 8s -->
          <div id="trimmer-alert-long" class="hidden p-2.5 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 text-xs font-medium flex items-start gap-2">
            <span class="text-base leading-none">⚠️</span>
            <span>Tu video dura más de 8 segundos. Usa los deslizadores para elegir el mejor tramo de 8s para la pantalla grande.</span>
          </div>

          <p class="text-xs text-slate-600 leading-relaxed">
            Ajusta los puntos de inicio y fin para proyectar en el evento:
          </p>

          <!-- Controles de Tiempo: Inicio y Fin -->
          <div class="space-y-3 bg-purple-50/50 p-3 rounded-xl border border-purple-100">
            <div>
              <div class="flex justify-between text-xs font-bold text-slate-700 mb-1">
                <span>Inicio del clip:</span>
                <span id="trimmer-start-val" class="text-purple-700 font-mono">0.0s</span>
              </div>
              <input 
                type="range" 
                id="trimmer-start-slider" 
                min="0" 
                max="10" 
                step="0.1" 
                value="0" 
                class="w-full accent-purple-600 cursor-pointer h-2.5 bg-slate-200 rounded-lg"
              />
            </div>

            <div>
              <div class="flex justify-between text-xs font-bold text-slate-700 mb-1">
                <span>Fin del clip (máx +8s):</span>
                <span id="trimmer-end-val" class="text-purple-700 font-mono">8.0s</span>
              </div>
              <input 
                type="range" 
                id="trimmer-end-slider" 
                min="1" 
                max="10" 
                step="0.1" 
                value="8" 
                class="w-full accent-purple-600 cursor-pointer h-2.5 bg-slate-200 rounded-lg"
              />
            </div>

            <!-- Resumen de Clip Recortado -->
            <div class="flex items-center justify-between text-xs pt-1 border-t border-purple-200/60 font-semibold">
              <span class="text-slate-600">Duración seleccionada:</span>
              <span id="trimmer-duration-val" class="font-mono text-purple-700 font-black bg-white px-2.5 py-0.5 rounded-md border border-purple-200">
                8.0s
              </span>
            </div>
          </div>

          <!-- Botones de Acción del Recortador -->
          <div class="flex gap-2">
            <button 
              type="button" 
              id="btn-preview-trimmed" 
              class="flex-1 py-2 px-3 rounded-xl bg-purple-100 hover:bg-purple-200 text-[#6D28D9] font-bold text-xs flex items-center justify-center gap-1.5 transition-all cursor-pointer"
            >
              <span>▶ Probar Selección</span>
            </button>
            <button 
              type="button" 
              id="btn-apply-trim" 
              class="flex-1 py-2 px-3 rounded-xl bg-[#7C3AED] hover:bg-[#6D28D9] text-white font-bold text-xs flex items-center justify-center gap-1.5 transition-all cursor-pointer shadow-md shadow-purple-500/20"
            >
              <span>✂️ Confirmar Recorte</span>
            </button>
          </div>
          <p id="trim-status-msg" class="hidden text-xs text-center text-purple-700 font-bold animate-pulse"></p>
        </div>

        <!-- Banner informativo SENATI -->
        <div class="p-3.5 rounded-2xl bg-blue-50/80 border border-blue-100 text-xs text-[#002855]">
          <p class="font-bold flex items-center gap-1.5 text-sm mb-1">
            <span class="w-2 h-2 rounded-full bg-[#00A3E0]"></span>
            Transmisión Inmediata
          </p>
          <p class="text-slate-600 leading-relaxed text-xs">
            Tu recuerdo saldrá con alta calidad y reproducción fluida en la pantalla gigante del evento.
          </p>
        </div>

        <!-- Botón de Envío Definitivo -->
        <button 
          type="button" 
          id="btn-confirm-upload" 
          class="w-full btn-bubble-senati text-white font-heading font-black text-base py-4 px-6 rounded-2xl uppercase tracking-wider flex items-center justify-center gap-2 cursor-pointer shadow-lg active:scale-98 transition-all"
        >
          <span>Transmitir a la Pantalla Gigante</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </button>
      </div>

    </div>
  </div>
</div>

<script>
  import confetti from 'canvas-confetti';
  import { galleryStore } from '../lib/store';
  import { uploadMediaToSupabase, SUPABASE_STORAGE_BUCKET } from '../lib/supabase';
  import type { MediaType } from '../lib/types';

  // ── Elementos DOM ──
  const methodsContainer    = document.getElementById('upload-methods-container');
  const btnCamera           = document.getElementById('btn-open-camera');
  const cameraFallbackInput = document.getElementById('camera-fallback-input') as HTMLInputElement;
  const cameraPhotoInput    = document.getElementById('camera-photo-input') as HTMLInputElement;
  const cameraVideoInput    = document.getElementById('camera-video-input') as HTMLInputElement;
  const fileGalleryInput    = document.getElementById('file-gallery-input') as HTMLInputElement;

  // Modal Selector de Modo de Cámara
  const cameraModeModal     = document.getElementById('camera-mode-modal');
  const btnCloseModeModal   = document.getElementById('btn-close-mode-modal');
  const btnCancelModeModal  = document.getElementById('btn-cancel-mode-modal');
  const btnSelectModePhoto  = document.getElementById('btn-select-mode-photo');
  const btnSelectModeVideo  = document.getElementById('btn-select-mode-video');
  const btnSelectModeWebcam = document.getElementById('btn-select-mode-webcam');

  // Cámara Pro
  const cameraModal         = document.getElementById('camera-modal');
  const cameraVideo         = document.getElementById('camera-video-feed') as HTMLVideoElement;
  const cameraCanvas        = document.getElementById('camera-capture-canvas') as HTMLCanvasElement;
  const cameraFlash         = document.getElementById('camera-shutter-flash')!;
  const btnCloseCamera      = document.getElementById('btn-close-camera');
  const btnFlipCamera       = document.getElementById('btn-flip-camera');
  const btnCameraTimer      = document.getElementById('btn-camera-timer');
  const cameraTimerLabel    = document.getElementById('camera-timer-label')!;
  const countdownBig        = document.getElementById('camera-countdown-big')!;
  const countdownBigNumber  = document.getElementById('camera-countdown-number')!;
  const modeTabPhoto        = document.getElementById('mode-tab-photo')!;
  const modeTabVideo        = document.getElementById('mode-tab-video')!;
  const btnShutterPhoto     = document.getElementById('btn-shutter-photo')!;
  const btnShutterVideo     = document.getElementById('btn-shutter-video')!;
  const countdownOverlay    = document.getElementById('countdown-overlay')!;
  const countdownSeconds    = document.getElementById('countdown-seconds')!;
  const videoRecordBar      = document.getElementById('video-record-progress-bar')!;
  const cameraShutterHint   = document.getElementById('camera-shutter-hint')!;
  const filterButtons       = document.querySelectorAll<HTMLButtonElement>('.cam-filter-btn');

  // Previsualización y Recorte
  const previewPanel        = document.getElementById('preview-panel');
  const previewImg          = document.getElementById('preview-image-element') as HTMLImageElement;
  const previewVideo        = document.getElementById('preview-video-element') as HTMLVideoElement;
  const previewTitle        = document.getElementById('preview-title');
  const btnDiscard          = document.getElementById('btn-discard-preview');
  const btnConfirm          = document.getElementById('btn-confirm-upload') as HTMLButtonElement;
  const badgeTrimmedOk      = document.getElementById('badge-trimmed-ok');
  const badgeTrimmedText    = document.getElementById('badge-trimmed-text');

  // Recortador de Video
  const videoTrimmerBox     = document.getElementById('video-trimmer-box')!;
  const trimmerBadgeTotal   = document.getElementById('trimmer-badge-original-time')!;
  const trimmerAlertLong    = document.getElementById('trimmer-alert-long')!;
  const trimmerStartSlider  = document.getElementById('trimmer-start-slider') as HTMLInputElement;
  const trimmerEndSlider    = document.getElementById('trimmer-end-slider') as HTMLInputElement;
  const trimmerStartVal     = document.getElementById('trimmer-start-val')!;
  const trimmerEndVal       = document.getElementById('trimmer-end-val')!;
  const trimmerDurationVal  = document.getElementById('trimmer-duration-val')!;
  const btnPreviewTrimmed   = document.getElementById('btn-preview-trimmed')!;
  const btnApplyTrim        = document.getElementById('btn-apply-trim')!;
  const trimStatusMsg       = document.getElementById('trim-status-msg')!;

  // ── Estado ──
  let mediaStream: MediaStream | null = null;
  let mediaRecorder: MediaRecorder | null = null;
  let recordedChunks: Blob[] = [];
  let recordTimer: any = null;
  let recordStartTime = 0;
  let currentFacingMode: 'environment' | 'user' = 'environment';
  let activeCameraMode: 'photo' | 'video' = 'photo';
  let cameraTimerSeconds = 0; // 0s o 3s
  let isTimerRunning = false;
  let activeFilterKey: 'normal' | 'senati' | 'warm' | 'bw' = 'normal';

  const FILTER_STYLES: Record<string, string> = {
    normal: 'none',
    senati: 'contrast(1.08) saturate(1.20) brightness(1.02)',
    warm: 'sepia(0.22) saturate(1.15) brightness(1.03)',
    bw: 'grayscale(1) contrast(1.22)'
  };

  let currentFile: File | Blob | null = null;
  let currentMediaUrl: string | null = null;
  let currentMediaType: MediaType = 'image';
  let currentSource: 'camera' | 'upload' = 'upload';
  let videoDuration: number | undefined = undefined;

  // Variables de recorte
  let rawVideoDuration = 0;
  let trimStartTime = 0;
  let trimEndTime = 8;
  let isTrimPreviewActive = false;

  // ── Sonido y Vibración de Disparador ──
  function triggerShutterFeedback() {
    try {
      const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
      if (AudioCtx) {
        const ctx = new AudioCtx();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(800, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(120, ctx.currentTime + 0.08);
        gain.gain.setValueAtTime(0.3, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.08);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.08);
      }
    } catch {}

    try {
      if ('vibrate' in navigator) {
        navigator.vibrate([40, 20, 60]);
      }
    } catch {}
  }

  // ── Filtros en Vivo ──
  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filterKey = btn.getAttribute('data-filter') as 'normal' | 'senati' | 'warm' | 'bw';
      if (!filterKey) return;
      activeFilterKey = filterKey;

      // Actualizar estilo activo de botones
      filterButtons.forEach((b) => {
        b.className = 'cam-filter-btn px-3 py-1 rounded-xl text-xs font-bold transition-all cursor-pointer bg-white/10 text-white/80 hover:bg-white/20';
      });
      btn.className = 'cam-filter-btn px-3 py-1 rounded-xl text-xs font-bold transition-all cursor-pointer bg-cyan-500 text-white shadow-xs';

      if (cameraVideo) {
        cameraVideo.style.filter = FILTER_STYLES[filterKey] || 'none';
      }
    });
  });

  // ── Temporizador (0s / 3s) ──
  btnCameraTimer?.addEventListener('click', () => {
    cameraTimerSeconds = cameraTimerSeconds === 0 ? 3 : 0;
    cameraTimerLabel.textContent = `${cameraTimerSeconds}s`;
    btnCameraTimer.className = cameraTimerSeconds > 0
      ? 'flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-cyan-500 text-white text-xs font-bold transition-all cursor-pointer shadow-xs'
      : 'flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-white/10 hover:bg-white/20 active:scale-95 text-white text-xs font-bold transition-all cursor-pointer border border-white/15';
  });

  // ═══════════════════════════════════════════════════════════════════
  //  SELECTOR DE MODO DE CÁMARA (FOTO vs VIDEO vs VISOR PRO)
  // ═══════════════════════════════════════════════════════════════════
  function triggerNativeInput(input: HTMLInputElement | null) {
    if (!input) return;
    input.value = ''; // Reset previo seguro para asegurar evento change
    input.click();
  }

  function openCameraModeModal() {
    cameraModeModal?.classList.remove('hidden');
  }

  function closeCameraModeModal() {
    cameraModeModal?.classList.add('hidden');
  }

  btnCamera?.addEventListener('click', openCameraModeModal);
  btnCloseModeModal?.addEventListener('click', closeCameraModeModal);
  btnCancelModeModal?.addEventListener('click', closeCameraModeModal);
  cameraModeModal?.addEventListener('click', (e) => {
    if (e.target === cameraModeModal) closeCameraModeModal();
  });

  btnSelectModePhoto?.addEventListener('click', () => {
    closeCameraModeModal();
    activeCameraMode = 'photo';
    const isMobile = /Mobi|Android|iPhone|iPad|iPod/i.test(navigator.userAgent) ||
      (navigator.maxTouchPoints > 1 && !window.matchMedia('(pointer: fine)').matches);

    if (isMobile) {
      triggerNativeInput(cameraPhotoInput);
    } else {
      openWebRtcCamera('photo');
    }
  });

  btnSelectModeVideo?.addEventListener('click', () => {
    closeCameraModeModal();
    activeCameraMode = 'video';
    const isMobile = /Mobi|Android|iPhone|iPad|iPod/i.test(navigator.userAgent) ||
      (navigator.maxTouchPoints > 1 && !window.matchMedia('(pointer: fine)').matches);

    if (isMobile) {
      triggerNativeInput(cameraVideoInput);
    } else {
      openWebRtcCamera('video');
    }
  });

  btnSelectModeWebcam?.addEventListener('click', () => {
    closeCameraModeModal();
    openWebRtcCamera(activeCameraMode || 'photo');
  });

  async function openWebRtcCamera(mode: 'photo' | 'video' = 'photo') {
    activeCameraMode = mode;
    if (mode === 'video') {
      modeTabVideo?.click();
    } else {
      modeTabPhoto?.click();
    }
    await startCameraStream();
  }

  // ═══════════════════════════════════════════════════════════════════
  //  CÁMARA PRO WEBRTC: getUserMedia EN ALTA RESOLUCIÓN + CAMBIO DE LENTE
  // ═══════════════════════════════════════════════════════════════════
  async function startCameraStream() {
    if (mediaStream) {
      mediaStream.getTracks().forEach(track => track.stop());
      mediaStream = null;
    }

    try {
      mediaStream = await navigator.mediaDevices.getUserMedia({
        video: {
          facingMode: { ideal: currentFacingMode },
          width: { ideal: 1920, max: 2560 },
          height: { ideal: 1080, max: 1440 },
          frameRate: { ideal: 30, max: 60 }
        },
        audio: { echoCancellation: true, noiseSuppression: true }
      });

      if (cameraVideo) {
        cameraVideo.srcObject = mediaStream;
        cameraVideo.style.transform = currentFacingMode === 'user' ? 'scaleX(-1)' : 'scaleX(1)';
        cameraVideo.style.filter = FILTER_STYLES[activeFilterKey] || 'none';
        await cameraVideo.play();
      }

      cameraModal?.classList.remove('hidden');
      methodsContainer?.classList.add('hidden');
    } catch (err) {
      console.warn('getUserMedia no disponible, activando input nativo:', err);
      triggerNativeInput(activeCameraMode === 'video' ? cameraVideoInput : cameraPhotoInput);
    }
  }

  btnFlipCamera?.addEventListener('click', async () => {
    currentFacingMode = currentFacingMode === 'environment' ? 'user' : 'environment';
    await startCameraStream();
  });

  function stopCamera() {
    stopRecording();
    if (mediaStream) {
      mediaStream.getTracks().forEach((track) => track.stop());
      mediaStream = null;
    }
    cameraModal?.classList.add('hidden');
    methodsContainer?.classList.remove('hidden');
  }

  btnCloseCamera?.addEventListener('click', stopCamera);

  // ── Pestañas de Modo (Foto vs Video 8s) ──
  modeTabPhoto?.addEventListener('click', () => {
    activeCameraMode = 'photo';
    modeTabPhoto.className = 'px-6 py-2 rounded-xl text-xs font-black uppercase tracking-wider transition-all cursor-pointer bg-cyan-500 text-white shadow-md flex items-center gap-1.5';
    modeTabVideo.className = 'px-6 py-2 rounded-xl text-xs font-black uppercase tracking-wider transition-all cursor-pointer text-white/70 hover:text-white flex items-center gap-1.5';
    btnShutterPhoto.classList.remove('hidden');
    btnShutterVideo.classList.add('hidden');
    cameraShutterHint.textContent = 'Toca para capturar tu mejor fotografía';
  });

  modeTabVideo?.addEventListener('click', () => {
    activeCameraMode = 'video';
    modeTabVideo.className = 'px-6 py-2 rounded-xl text-xs font-black uppercase tracking-wider transition-all cursor-pointer bg-red-600 text-white shadow-md flex items-center gap-1.5';
    modeTabPhoto.className = 'px-6 py-2 rounded-xl text-xs font-black uppercase tracking-wider transition-all cursor-pointer text-white/70 hover:text-white flex items-center gap-1.5';
    btnShutterVideo.classList.remove('hidden');
    btnShutterPhoto.classList.add('hidden');
    cameraShutterHint.textContent = 'Toca para grabar un clip en vivo de hasta 8 segundos';
  });

  // ── Tomar Foto con Temporizador, Flash Visual y Filtro ──
  btnShutterPhoto?.addEventListener('click', () => {
    if (isTimerRunning) return;

    if (cameraTimerSeconds > 0) {
      isTimerRunning = true;
      countdownBig.classList.remove('hidden');
      let count = cameraTimerSeconds;
      countdownBigNumber.textContent = String(count);

      const interval = setInterval(() => {
        count--;
        if (count > 0) {
          countdownBigNumber.textContent = String(count);
        } else {
          clearInterval(interval);
          countdownBig.classList.add('hidden');
          isTimerRunning = false;
          executePhotoCapture();
        }
      }, 1000);
    } else {
      executePhotoCapture();
    }
  });

  function executePhotoCapture() {
    if (!cameraVideo || !cameraCanvas) return;

    triggerShutterFeedback();

    // Efecto de flash de obturador
    cameraFlash.style.opacity = '0.9';
    setTimeout(() => { cameraFlash.style.opacity = '0'; }, 150);

    const w = cameraVideo.videoWidth || 1280;
    const h = cameraVideo.videoHeight || 720;
    cameraCanvas.width = w;
    cameraCanvas.height = h;

    const ctx = cameraCanvas.getContext('2d');
    if (ctx) {
      // Aplicar filtro seleccionado
      const filterCss = FILTER_STYLES[activeFilterKey] || 'none';
      ctx.filter = filterCss;

      if (currentFacingMode === 'user') {
        ctx.translate(w, 0);
        ctx.scale(-1, 1);
      }
      ctx.drawImage(cameraVideo, 0, 0, w, h);

      currentMediaUrl = cameraCanvas.toDataURL('image/webp', 0.88);
      cameraCanvas.toBlob((blob) => {
        if (blob) {
          currentFile = new File([blob], `photo_${Date.now()}.webp`, { type: 'image/webp' });
        }
      }, 'image/webp', 0.88);

      currentMediaType = 'image';
      currentSource = 'camera';
      videoDuration = undefined;

      stopCamera();
      showPreview();
    }
  }

  // ── Grabar Video de 8 Segundos con Barra de Progreso ──
  btnShutterVideo?.addEventListener('click', () => {
    if (mediaRecorder && mediaRecorder.state === 'recording') {
      stopRecording();
      return;
    }
    startRecording();
  });

  function startRecording() {
    if (!mediaStream) return;
    recordedChunks = [];
    recordStartTime = Date.now();
    triggerShutterFeedback();

    const mime = MediaRecorder.isTypeSupported('video/webm;codecs=vp9')
      ? 'video/webm;codecs=vp9'
      : (MediaRecorder.isTypeSupported('video/webm') ? 'video/webm' : 'video/mp4');

    try {
      mediaRecorder = new MediaRecorder(mediaStream, { mimeType: mime });
    } catch {
      mediaRecorder = new MediaRecorder(mediaStream);
    }

    mediaRecorder.ondataavailable = (e) => {
      if (e.data.size > 0) recordedChunks.push(e.data);
    };

    mediaRecorder.onstop = () => {
      triggerShutterFeedback();
      const blob = new Blob(recordedChunks, { type: 'video/webm' });
      currentFile = new File([blob], `video_${Date.now()}.webm`, { type: 'video/webm' });
      const elapsed = Math.min(8.0, Number(((Date.now() - recordStartTime) / 1000).toFixed(1)));
      rawVideoDuration = elapsed;
      videoDuration = elapsed;

      const reader = new FileReader();
      reader.onload = (e) => {
        currentMediaUrl = e.target?.result as string;
        currentMediaType = 'video';
        currentSource = 'camera';
        stopCamera();
        showPreview();
        initVideoTrimmer(rawVideoDuration);
      };
      reader.readAsDataURL(blob);
    };

    mediaRecorder.start(100);
    countdownOverlay.classList.remove('hidden');

    // Intervalo de 8 segundos
    const maxMs = 8000;
    recordTimer = setInterval(() => {
      const elapsedMs = Date.now() - recordStartTime;
      const leftSec = Math.max(0, (maxMs - elapsedMs) / 1000);
      countdownSeconds.textContent = leftSec.toFixed(1);
      const pct = Math.max(0, 100 - (elapsedMs / maxMs) * 100);
      videoRecordBar.style.width = `${pct}%`;

      if (elapsedMs >= maxMs) {
        stopRecording();
      }
    }, 50);
  }

  function stopRecording() {
    if (recordTimer) {
      clearInterval(recordTimer);
      recordTimer = null;
    }
    countdownOverlay.classList.add('hidden');
    if (mediaRecorder && mediaRecorder.state === 'recording') {
      mediaRecorder.stop();
    }
  }

  // ═══════════════════════════════════════════════════════════════════
  //  SELECCIÓN DESDE GALERÍA CON DETECCIÓN Y RECORTADOR DE VIDEO
  // ═══════════════════════════════════════════════════════════════════
  function handleSelectedFile(file: File, source: 'upload' | 'camera') {
    if (!file) {
      console.warn('handleSelectedFile: Archivo nulo o no válido');
      return;
    }

    currentFile = file;
    const isVideo = file.type.startsWith('video/') || /\.(mp4|webm|mov|m4v|3gp|avi)$/i.test(file.name);

    // Liberar URL temporal previa para optimizar memoria
    if (currentMediaUrl && currentMediaUrl.startsWith('blob:')) {
      try { URL.revokeObjectURL(currentMediaUrl); } catch {}
    }

    // Creación instantánea de URL local (0ms de latencia, sin saturar la RAM en fotos de 48MP)
    const objectUrl = URL.createObjectURL(file);
    currentMediaUrl = objectUrl;
    currentSource = source;

    if (isVideo) {
      currentMediaType = 'video';
      const tempVideo = document.createElement('video');
      tempVideo.preload = 'metadata';
      tempVideo.src = objectUrl;

      let isReady = false;
      const onVideoReady = () => {
        if (isReady) return;
        isReady = true;
        rawVideoDuration = tempVideo.duration || 8;
        videoDuration = Math.min(8.0, rawVideoDuration);
        showPreview();
        initVideoTrimmer(rawVideoDuration);
      };

      tempVideo.onloadedmetadata = onVideoReady;
      tempVideo.onerror = () => {
        if (isReady) return;
        isReady = true;
        rawVideoDuration = 8;
        videoDuration = 8;
        showPreview();
        initVideoTrimmer(rawVideoDuration);
      };

      // Respaldo de seguridad en caso de que el navegador móvil demore en emitir metadatos
      setTimeout(() => {
        if (!isReady) onVideoReady();
      }, 500);
    } else {
      currentMediaType = 'image';
      videoDuration = undefined;
      showPreview();
    }
  }

  fileGalleryInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) handleSelectedFile(file, 'upload');
  });

  cameraFallbackInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) handleSelectedFile(file, 'camera');
  });

  // Inputs nativos exclusivos de móvil (foto/video):
  // Importante: No borrar target.value aquí adentro para no invalidar el handle del archivo en Android/iOS
  cameraPhotoInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) handleSelectedFile(file, 'camera');
  });

  cameraVideoInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) handleSelectedFile(file, 'camera');
  });

  // ═══════════════════════════════════════════════════════════════════
  //  MÓDULO DE RECORTE DE VIDEO (TIMELINE TRIMMER)
  // ═══════════════════════════════════════════════════════════════════
  function initVideoTrimmer(duration: number) {
    videoTrimmerBox.classList.remove('hidden');
    trimmerBadgeTotal.textContent = `Original: ${duration.toFixed(1)}s`;

    // Si el video supera los 8 segundos, mostrar alerta amistosa
    if (duration > 8.0) {
      trimmerAlertLong?.classList.remove('hidden');
    } else {
      trimmerAlertLong?.classList.add('hidden');
    }

    trimStartTime = 0;
    trimEndTime = Math.min(8.0, duration);

    // Ajustar límites de los sliders
    trimmerStartSlider.min = '0';
    trimmerStartSlider.max = String(Math.max(0, duration - 0.5));
    trimmerStartSlider.value = '0';

    trimmerEndSlider.min = '0.5';
    trimmerEndSlider.max = String(duration);
    trimmerEndSlider.value = String(trimEndTime);

    updateTrimmerDisplay();
  }

  function updateTrimmerDisplay() {
    trimmerStartVal.textContent = `${trimStartTime.toFixed(1)}s`;
    trimmerEndVal.textContent = `${trimEndTime.toFixed(1)}s`;
    const dur = Math.max(0.5, Number((trimEndTime - trimStartTime).toFixed(1)));
    trimmerDurationVal.textContent = `${dur.toFixed(1)}s`;
    videoDuration = dur;

    if (badgeTrimmedText) {
      badgeTrimmedText.textContent = `Clip ajustado a ${dur.toFixed(1)}s`;
    }
  }

  trimmerStartSlider?.addEventListener('input', () => {
    trimStartTime = Number(trimmerStartSlider.value);
    if (trimEndTime < trimStartTime + 0.5) {
      trimEndTime = Math.min(rawVideoDuration, trimStartTime + 0.5);
      trimmerEndSlider.value = String(trimEndTime);
    }
    if (trimEndTime - trimStartTime > 8.0) {
      trimEndTime = Math.min(rawVideoDuration, trimStartTime + 8.0);
      trimmerEndSlider.value = String(trimEndTime);
    }
    updateTrimmerDisplay();

    if (previewVideo) {
      previewVideo.currentTime = trimStartTime;
    }
  });

  trimmerEndSlider?.addEventListener('input', () => {
    trimEndTime = Number(trimmerEndSlider.value);
    if (trimEndTime <= trimStartTime + 0.5) {
      trimStartTime = Math.max(0, trimEndTime - 0.5);
      trimmerStartSlider.value = String(trimStartTime);
    }
    if (trimEndTime - trimStartTime > 8.0) {
      trimStartTime = Math.max(0, trimEndTime - 8.0);
      trimmerStartSlider.value = String(trimStartTime);
    }
    updateTrimmerDisplay();

    if (previewVideo) {
      previewVideo.currentTime = trimStartTime;
    }
  });

  // Reproducir solo el tramo recortado en bucle
  btnPreviewTrimmed?.addEventListener('click', () => {
    if (!previewVideo) return;
    previewVideo.currentTime = trimStartTime;
    previewVideo.play();
    isTrimPreviewActive = true;
  });

  previewVideo?.addEventListener('timeupdate', () => {
    if (isTrimPreviewActive && previewVideo.currentTime >= trimEndTime) {
      previewVideo.currentTime = trimStartTime;
      previewVideo.play();
    }
  });

  // Aplicar el recorte generando un nuevo archivo
  btnApplyTrim?.addEventListener('click', async () => {
    await performVideoTrim();
  });

  async function performVideoTrim(): Promise<boolean> {
    if (!previewVideo || !currentMediaUrl) return false;

    trimStatusMsg.classList.remove('hidden');
    trimStatusMsg.textContent = '⏳ Extrayendo los mejores 8 segundos...';
    btnApplyTrim.classList.add('opacity-50');

    try {
      const trimmedResult = await createTrimmedVideo(currentMediaUrl, trimStartTime, trimEndTime);
      currentFile = new File([trimmedResult.blob], `video_recortado_${Date.now()}.webm`, { type: 'video/webm' });
      currentMediaUrl = trimmedResult.url;
      previewVideo.src = trimmedResult.url;
      previewVideo.currentTime = 0;
      previewVideo.play();

      trimStatusMsg.textContent = '✨ ¡Recorte completado con éxito!';
      badgeTrimmedOk?.classList.remove('hidden');
      setTimeout(() => trimStatusMsg.classList.add('hidden'), 3500);
      return true;
    } catch (err) {
      console.warn('Recorte asistido falló, asignando límites directos:', err);
      trimStatusMsg.textContent = `✓ Tramo seleccionado (${(trimEndTime - trimStartTime).toFixed(1)}s)`;
      badgeTrimmedOk?.classList.remove('hidden');
      setTimeout(() => trimStatusMsg.classList.add('hidden'), 3500);
      return true;
    } finally {
      btnApplyTrim.classList.remove('opacity-50');
    }
  }

  /**
   * Crea un Blob WebM recortado de forma 100% nativa en el navegador
   */
  async function createTrimmedVideo(sourceUrl: string, start: number, end: number): Promise<{ blob: Blob; url: string }> {
    return new Promise((resolve, reject) => {
      const tempVideo = document.createElement('video');
      tempVideo.src = sourceUrl;
      tempVideo.muted = true;
      tempVideo.playsInline = true;
      tempVideo.preload = 'auto';

      tempVideo.onloadedmetadata = () => {
        tempVideo.currentTime = start;
      };

      tempVideo.onseeked = async () => {
        tempVideo.onseeked = null;
        try {
          let stream: MediaStream | null = null;
          if ((tempVideo as any).captureStream) {
            stream = (tempVideo as any).captureStream();
          } else if ((tempVideo as any).mozCaptureStream) {
            stream = (tempVideo as any).mozCaptureStream();
          }

          if (!stream) {
            const canvas = document.createElement('canvas');
            canvas.width = tempVideo.videoWidth || 640;
            canvas.height = tempVideo.videoHeight || 480;
            stream = canvas.captureStream(30);
          }

          const mime = MediaRecorder.isTypeSupported('video/webm;codecs=vp9')
            ? 'video/webm;codecs=vp9'
            : (MediaRecorder.isTypeSupported('video/webm') ? 'video/webm' : 'video/mp4');

          const recorder = new MediaRecorder(stream, { mimeType: mime });
          const chunks: Blob[] = [];

          recorder.ondataavailable = (e) => {
            if (e.data.size > 0) chunks.push(e.data);
          };

          recorder.onstop = () => {
            const blob = new Blob(chunks, { type: mime });
            resolve({ blob, url: URL.createObjectURL(blob) });
          };

          recorder.start(100);
          await tempVideo.play();

          const durationMs = Math.max(500, (end - start) * 1000);
          setTimeout(() => {
            tempVideo.pause();
            if (recorder.state === 'recording') recorder.stop();
          }, durationMs);
        } catch (e) {
          reject(e);
        }
      };

      tempVideo.onerror = (e) => reject(e);
    });
  }

  // ═══════════════════════════════════════════════════════════════════
  //  PREVISUALIZACIÓN Y TRANSMISIÓN FINAL
  // ═══════════════════════════════════════════════════════════════════
  function showPreview() {
    if (!currentMediaUrl || !previewPanel) return;

    if (currentMediaType === 'video') {
      if (previewImg) previewImg.classList.add('hidden');
      if (previewVideo) {
        previewVideo.classList.remove('hidden');
        previewVideo.src = currentMediaUrl;
        previewVideo.play().catch(() => {});
      }
      if (previewTitle) previewTitle.textContent = 'Vista Previa de Video (8s)';
    } else {
      videoTrimmerBox.classList.add('hidden');
      if (previewVideo) {
        previewVideo.pause();
        previewVideo.classList.add('hidden');
      }
      if (previewImg) {
        previewImg.classList.remove('hidden');
        previewImg.src = currentMediaUrl;
      }
      if (previewTitle) previewTitle.textContent = 'Vista Previa de Fotografía';
    }

    previewPanel.classList.remove('hidden');
    methodsContainer?.classList.add('hidden');

    // Auto-scroll al panel de preview para que el usuario lo vea inmediatamente
    setTimeout(() => {
      previewPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 120);
  }

  /**
   * Comprime cualquier imagen a WebP (Full HD 1920px max, calidad 82%)
   * Reduce el tamaño del archivo entre 80% y 92% para ahorrar cuota en Supabase
   */
  async function compressImageToWebP(file: File | Blob): Promise<File> {
    return new Promise((resolve) => {
      const img = new Image();
      const url = URL.createObjectURL(file);
      img.onload = () => {
        URL.revokeObjectURL(url);
        const canvas = document.createElement('canvas');
        const maxDim = 1920;
        let w = img.width;
        let h = img.height;
        if (w > maxDim || h > maxDim) {
          if (w > h) {
            h = Math.round((h * maxDim) / w);
            w = maxDim;
          } else {
            w = Math.round((w * maxDim) / h);
            h = maxDim;
          }
        }
        canvas.width = w;
        canvas.height = h;
        const ctx = canvas.getContext('2d');
        if (ctx) {
          ctx.drawImage(img, 0, 0, w, h);
          canvas.toBlob((blob) => {
            if (blob) {
              const webpFile = new File([blob], `senati_${Date.now()}.webp`, {
                type: 'image/webp',
                lastModified: Date.now()
              });
              resolve(webpFile);
            } else {
              resolve(file instanceof File ? file : new File([file], `senati_${Date.now()}.jpg`, { type: 'image/jpeg' }));
            }
          }, 'image/webp', 0.82);
        } else {
          resolve(file instanceof File ? file : new File([file], `senati_${Date.now()}.jpg`, { type: 'image/jpeg' }));
        }
      };
      img.onerror = () => {
        URL.revokeObjectURL(url);
        resolve(file instanceof File ? file : new File([file], `senati_${Date.now()}.jpg`, { type: 'image/jpeg' }));
      };
      img.src = url;
    });
  }

  async function compressImageForOffline(file: File | Blob): Promise<string> {
    return new Promise((resolve) => {
      const img = new Image();
      const url = URL.createObjectURL(file);
      img.onload = () => {
        URL.revokeObjectURL(url);
        const canvas = document.createElement('canvas');
        const maxDim = 1200;
        let w = img.width;
        let h = img.height;
        if (w > maxDim || h > maxDim) {
          if (w > h) {
            h = Math.round((h * maxDim) / w);
            w = maxDim;
          } else {
            w = Math.round((w * maxDim) / h);
            h = maxDim;
          }
        }
        canvas.width = w;
        canvas.height = h;
        const ctx = canvas.getContext('2d');
        if (ctx) {
          ctx.drawImage(img, 0, 0, w, h);
          resolve(canvas.toDataURL('image/webp', 0.8));
        } else {
          resolve(url);
        }
      };
      img.onerror = () => {
        URL.revokeObjectURL(url);
        resolve(currentMediaUrl || '');
      };
      img.src = url;
    });
  }

  btnDiscard?.addEventListener('click', () => {
    if (currentMediaUrl && currentMediaUrl.startsWith('blob:')) {
      try { URL.revokeObjectURL(currentMediaUrl); } catch {}
    }
    currentMediaUrl = null;
    currentFile = null;
    isTrimPreviewActive = false;
    previewPanel?.classList.add('hidden');
    videoTrimmerBox?.classList.add('hidden');
    badgeTrimmedOk?.classList.add('hidden');
    methodsContainer?.classList.remove('hidden');
    if (previewVideo) previewVideo.pause();
    if (fileGalleryInput) fileGalleryInput.value = '';
    if (cameraFallbackInput) cameraFallbackInput.value = '';
    if (cameraPhotoInput) cameraPhotoInput.value = '';
    if (cameraVideoInput) cameraVideoInput.value = '';
  });

  // Transmitir a la nube y a la Pantalla Gigante
  btnConfirm?.addEventListener('click', async () => {
    if (!currentMediaUrl && !currentFile) return;

    if (btnConfirm) {
      btnConfirm.innerHTML = `
        <svg class="animate-spin -ml-1 mr-2 h-5 w-5 text-white inline" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
        </svg>
        <span>Transmitiendo a la Pantalla Gigante...</span>
      `;
      btnConfirm.disabled = true;
    }

    // Si es video y dura más de 8s o se modificaron los cortes pero no se confirmó explícitamente el botón "✂️", recortar ahora
    if (currentMediaType === 'video' && rawVideoDuration > 8.0 && (!badgeTrimmedOk || badgeTrimmedOk.classList.contains('hidden'))) {
      try {
        await performVideoTrim();
      } catch {}
    } else if (currentMediaType === 'video' && currentFile && currentFile.size > 8 * 1024 * 1024) {
      // Si el video pesa más de 8MB, optimizarlo para ahorrar almacenamiento
      try {
        await performVideoTrim();
      } catch {}
    }

    // Si es imagen, comprimirla a WebP para reducir drásticamente el peso y acelerar la subida
    if (currentMediaType === 'image' && currentFile) {
      try {
        currentFile = await compressImageToWebP(currentFile);
      } catch (err) {
        console.warn('Compresión WebP advertencia:', err);
      }
    }

    const session = galleryStore.getSession();
    const userId = session?.email || session?.phone || session?.name || 'Asistente SENATI';

    let finalUrl = currentMediaUrl;
    let finalId: string | undefined = undefined;

    // 1. Subir archivo a Supabase Storage ('event-media') y registrar en DB
    if (currentFile) {
      try {
        const uploadResult = await uploadMediaToSupabase(
          currentFile,
          userId,
          currentMediaType,
          videoDuration
        );

        if (uploadResult && uploadResult.publicUrl) {
          finalUrl = uploadResult.publicUrl;
          finalId = uploadResult.dbId;
        }
      } catch (err: any) {
        console.warn('Subida a Supabase con advertencia:', err);
        // Si Supabase no está disponible, comprimir imagen para almacenamiento local sin exceder cuota
        if (currentMediaType === 'image') {
          try {
            finalUrl = await compressImageForOffline(currentFile);
          } catch {}
        }
        if (err?.message?.includes('Bucket not found') || err?.message?.includes('row-level security') || err?.message?.includes('Storage:')) {
          alert(`⚠️ Aviso: La foto se transmitió localmente. En Supabase falta crear el bucket "${SUPABASE_STORAGE_BUCKET}" y habilitar las políticas RLS en el SQL Editor.`);
        }
      }
    }

    // 2. Agregar a la tienda local y sincronizar con todos
    galleryStore.addPhoto({
      id: finalId,
      url: finalUrl!,
      mediaType: currentMediaType,
      durationSeconds: videoDuration,
      source: currentSource,
      author: userId,
      uploaderDeviceId: galleryStore.getDeviceId()
    });

    try {
      confetti({
        particleCount: 70,
        spread: 90,
        origin: { y: 0.6 },
        colors: ['#00A3E0', '#7C3AED', '#FFD700', '#FFFFFF']
      });
    } catch {}

    // 3. Limpiar estado
    if (currentMediaUrl && currentMediaUrl.startsWith('blob:')) {
      try { URL.revokeObjectURL(currentMediaUrl); } catch {}
    }
    currentMediaUrl = null;
    currentFile = null;
    isTrimPreviewActive = false;
    if (fileGalleryInput) fileGalleryInput.value = '';
    if (cameraFallbackInput) cameraFallbackInput.value = '';
    if (cameraPhotoInput) cameraPhotoInput.value = '';
    if (cameraVideoInput) cameraVideoInput.value = '';
    if (previewVideo) previewVideo.pause();
    previewPanel?.classList.add('hidden');
    videoTrimmerBox?.classList.add('hidden');
    badgeTrimmedOk?.classList.add('hidden');
    methodsContainer?.classList.remove('hidden');

    if (btnConfirm) {
      btnConfirm.disabled = false;
      btnConfirm.innerHTML = `
        <span>Transmitir a la Pantalla Gigante</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      `;
    }

    const feed = document.getElementById('photo-wall-grid');
    feed?.scrollIntoView({ behavior: 'smooth' });
  });
</script>
