---
// PhotoUploader.astro — Captura y Subida Directa SENATI (Optimizada para móviles y sin filtros/recortes)
---

<div class="w-full bg-white rounded-3xl p-3.5 sm:p-6 lg:p-7 shadow-xl shadow-slate-200/50 border border-slate-100 transition-all">
  <!-- Encabezado responsivo -->
  <div class="flex items-center justify-between mb-4 sm:mb-5 pb-3 border-b border-slate-100 gap-2">
    <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
      <div class="w-9 h-9 sm:w-11 sm:h-11 rounded-2xl bg-[#00A3E0]/15 text-[#002855] flex items-center justify-center shadow-xs shrink-0">
        <svg class="w-5 h-5 sm:w-6 sm:h-6 text-[#00A3E0]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
      </div>
      <div class="min-w-0">
        <h3 class="font-heading font-black text-base sm:text-2xl text-[#002855] truncate">
          Subir a la Pantalla Gigante
        </h3>
        <p class="text-[11px] sm:text-sm text-slate-500 font-medium truncate sm:whitespace-normal">
          Toma una foto o súbela para proyectarla al instante
        </p>
      </div>
    </div>
    <span id="header-live-badge" class="inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-1 rounded-full text-[10px] sm:text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 shadow-xs shrink-0">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span class="hidden sm:inline">Transmisión Activa</span>
      <span class="sm:hidden">En Vivo</span>
    </span>
  </div>

  <!-- Botones de Acción Inicial (Cámara vs Galería) -->
  <div id="upload-methods-container" class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
    <!-- Banner de Transmisión Finalizada (Modo Admin) -->
    <div 
      id="transmission-closed-banner" 
      class="hidden col-span-1 sm:col-span-2 p-5 sm:p-8 rounded-3xl bg-gradient-to-br from-red-950/90 via-slate-900/95 to-purple-950/90 border-2 border-red-500/50 shadow-2xl backdrop-blur-xl text-center text-white"
    >
      <div class="w-14 h-14 sm:w-18 sm:h-18 mx-auto mb-3 rounded-2xl bg-gradient-to-tr from-red-600 to-rose-400 text-white flex items-center justify-center text-2xl sm:text-3xl shadow-lg shadow-red-600/30 border border-red-300/30">
        ⏹️
      </div>
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] sm:text-[11px] font-black uppercase tracking-wider bg-red-500/20 text-red-300 border border-red-500/30 mb-2">
        Transmisión Oficial Finalizada
      </span>
      <h3 class="font-heading font-black text-lg sm:text-2xl text-white">
        El Evento SENATI TEC ha Concluido
      </h3>
      <p class="text-xs sm:text-sm text-slate-300 mt-2 max-w-lg mx-auto leading-relaxed">
        Las subidas de nuevas fotos y videos están cerradas para esta sesión. Muchas gracias a todos los estudiantes y docentes por compartir sus momentos.
      </p>
    </div>

    <!-- Opción 1: Cámara -->
    <button 
      type="button" 
      id="btn-open-camera"
      class="group p-4 sm:p-6 rounded-2xl border-2 border-dashed border-[#00A3E0]/70 hover:border-[#002855] bg-gradient-to-br from-sky-50/80 via-white to-blue-50/40 hover:from-sky-100/70 hover:to-blue-100/50 flex flex-row sm:flex-col items-center justify-start sm:justify-center gap-3.5 sm:gap-4 transition-all cursor-pointer shadow-xs hover:shadow-md active:scale-[0.99]"
    >
      <div class="relative w-12 h-12 sm:w-16 sm:h-16 rounded-2xl bg-gradient-to-tr from-[#004B93] to-[#00A3E0] text-white flex items-center justify-center shadow-md shadow-sky-500/25 shrink-0 group-hover:scale-105 transition-transform">
        <svg class="w-6 h-6 sm:w-8 sm:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        <span class="absolute -top-1 -right-1 w-3 h-3 sm:w-3.5 sm:h-3.5 rounded-full bg-emerald-400 border-2 border-white"></span>
      </div>
      <div class="text-left sm:text-center min-w-0">
        <span class="font-heading font-black text-[#002855] text-sm sm:text-lg block group-hover:text-[#00A3E0] transition-colors">
          Tomar Foto / Cámara
        </span>
        <span class="text-[11px] sm:text-xs text-slate-500 font-medium block mt-0.5">
          Abre la cámara de tu celular y captura el momento
        </span>
      </div>
    </button>

    <!-- Opción 2: Subir desde Galería -->
    <label 
      for="file-gallery-input"
      class="group p-4 sm:p-6 rounded-2xl border-2 border-dashed border-slate-300 hover:border-[#7C3AED] bg-gradient-to-br from-slate-50/80 via-white to-purple-50/30 hover:from-purple-50/70 hover:to-indigo-50/50 flex flex-row sm:flex-col items-center justify-start sm:justify-center gap-3.5 sm:gap-4 transition-all cursor-pointer shadow-xs hover:shadow-md active:scale-[0.99]"
    >
      <div class="w-12 h-12 sm:w-16 sm:h-16 rounded-2xl bg-gradient-to-tr from-[#6D28D9] to-[#9333EA] text-white flex items-center justify-center shadow-md shadow-purple-500/25 shrink-0 group-hover:scale-105 transition-transform">
        <svg class="w-6 h-6 sm:w-8 sm:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
      </div>
      <div class="text-left sm:text-center min-w-0">
        <span class="font-heading font-black text-slate-800 text-sm sm:text-lg block group-hover:text-[#7C3AED] transition-colors">
          Subir desde Galería
        </span>
        <span class="text-[11px] sm:text-xs text-slate-500 font-medium block mt-0.5">
          Selecciona una foto o video almacenado en tu dispositivo
        </span>
      </div>
      <input 
        type="file" 
        id="file-gallery-input" 
        accept="image/*,video/mp4,video/webm,video/quicktime,video/mov,video/*" 
        class="hidden"
      />
    </label>
  </div>

  <!-- Inputs nativos para cámara móvil y subida -->
  <input 
    type="file" 
    id="camera-photo-input" 
    accept="image/*" 
    capture="environment" 
    class="hidden"
  />

  <input 
    type="file" 
    id="camera-video-input" 
    accept="video/*" 
    capture="environment" 
    class="hidden"
  />

  <input 
    type="file" 
    id="camera-fallback-input" 
    accept="image/*,video/*" 
    capture="environment" 
    class="hidden"
  />

  <!-- ═══════════════════════════════════════════════════════════════════
       MODAL SELECTOR DE CÁMARA (RESPONSIVO PARA MÓVILES)
  ═══════════════════════════════════════════════════════════════════ -->
  <div 
    id="camera-mode-modal" 
    class="hidden fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-slate-950/80 backdrop-blur-md transition-all duration-200"
    role="dialog"
    aria-modal="true"
    aria-labelledby="camera-modal-title"
  >
    <div class="relative w-full max-w-sm sm:max-w-md max-h-[90vh] overflow-y-auto bg-gradient-to-b from-[#001736] via-[#051126] to-[#000d1f] rounded-3xl p-4 sm:p-6 border border-cyan-500/40 shadow-[0_0_50px_rgba(0,163,224,0.3)] text-white animate-in fade-in duration-200">
      
      <!-- Botón Cerrar -->
      <button 
        type="button" 
        id="btn-close-mode-modal" 
        class="absolute top-3.5 right-3.5 w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 text-white/80 hover:text-white flex items-center justify-center transition-all cursor-pointer border border-white/10 text-xs font-bold"
        aria-label="Cerrar modal"
      >
        ✕
      </button>

      <!-- Encabezado del selector -->
      <div class="text-center mb-4 px-2">
        <div class="inline-flex items-center justify-center w-11 h-11 sm:w-12 sm:h-12 rounded-2xl bg-gradient-to-tr from-[#00A3E0] to-[#004B93] text-white shadow-lg shadow-cyan-500/30 mb-2 border border-cyan-300/30">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
        </div>
        <h3 id="camera-modal-title" class="font-heading font-black text-base sm:text-xl text-white">
          Cámara en Vivo SENATI TEC
        </h3>
        <p class="text-xs text-cyan-200/80 mt-0.5 leading-snug">
          Elige qué deseas capturar para la pantalla gigante
        </p>
      </div>

      <!-- Opciones Principales de Captura -->
      <div class="space-y-2.5 sm:space-y-3">
        <!-- Opción 1: FOTO NATIVA -->
        <button 
          type="button" 
          id="btn-select-mode-photo"
          class="w-full group p-3 sm:p-4 rounded-2xl bg-gradient-to-r from-sky-500/15 to-blue-500/15 hover:from-sky-500/25 hover:to-blue-500/25 border-2 border-cyan-400/40 hover:border-cyan-300 active:scale-[0.98] transition-all flex items-center gap-3 text-left cursor-pointer shadow-md"
        >
          <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-2xl bg-gradient-to-tr from-cyan-500 to-sky-400 text-white flex items-center justify-center shrink-0 shadow-md shadow-cyan-500/30 group-hover:scale-105 transition-transform">
            <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center justify-between gap-1">
              <span class="font-heading font-black text-sm sm:text-base text-white group-hover:text-cyan-300 transition-colors">
                📸 Tomar Fotografía
              </span>
              <span class="text-[9px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 shrink-0">
                HD
              </span>
            </div>
            <p class="text-[11px] sm:text-xs text-slate-300 mt-0.5 leading-snug">
              Abre la cámara de tu teléfono al instante
            </p>
          </div>
        </button>

        <!-- Opción 2: VIDEO NATIVO -->
        <button 
          type="button" 
          id="btn-select-mode-video"
          class="w-full group p-3 sm:p-4 rounded-2xl bg-gradient-to-r from-red-500/15 to-rose-500/15 hover:from-red-500/25 hover:to-rose-500/25 border-2 border-red-500/40 hover:border-red-400 active:scale-[0.98] transition-all flex items-center gap-3 text-left cursor-pointer shadow-md"
        >
          <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-2xl bg-gradient-to-tr from-red-600 to-rose-400 text-white flex items-center justify-center shrink-0 shadow-md shadow-red-500/30 group-hover:scale-105 transition-transform">
            <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center justify-between gap-1">
              <span class="font-heading font-black text-sm sm:text-base text-white group-hover:text-red-300 transition-colors">
                🎥 Grabar Video Corto
              </span>
              <span class="text-[9px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-red-500/20 text-red-300 border border-red-500/30 shrink-0">
                Máx 8s
              </span>
            </div>
            <p class="text-[11px] sm:text-xs text-slate-300 mt-0.5 leading-snug">
              Clip dinámico para la pantalla gigante
            </p>
          </div>
        </button>

        <!-- Opción 3: Visor WebRTC en Pantalla -->
        <button 
          type="button" 
          id="btn-select-mode-webcam"
          class="w-full group p-3 sm:p-3.5 rounded-2xl bg-white/5 hover:bg-white/10 border border-purple-500/30 hover:border-purple-400 active:scale-[0.98] transition-all flex items-center gap-3 text-left cursor-pointer"
        >
          <div class="w-10 h-10 rounded-xl bg-purple-500/20 text-purple-300 flex items-center justify-center shrink-0 border border-purple-500/30">
            <span class="text-base sm:text-lg">💻</span>
          </div>
          <div class="flex-1 min-w-0">
            <span class="font-heading font-bold text-xs sm:text-sm text-purple-200 group-hover:text-purple-100 block">
              Visor en Pantalla con Temporizador
            </span>
            <span class="text-[10px] sm:text-[11px] text-slate-400 block leading-snug">
              Cámara integrada con temporizador 3s
            </span>
          </div>
        </button>
      </div>

      <!-- Pie del modal -->
      <div class="mt-4 pt-3 border-t border-white/10 flex justify-center">
        <button 
          type="button" 
          id="btn-cancel-mode-modal"
          class="text-xs sm:text-sm font-bold text-slate-400 hover:text-white px-5 py-2 rounded-xl hover:bg-white/10 transition-colors cursor-pointer"
        >
          Cancelar
        </button>
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════
       VISOR DE CÁMARA WEBRTC (SIN FILTROS, RESPONSIVO PARA MÓVILES)
  ═══════════════════════════════════════════════════════════════════ -->
  <div id="camera-modal" class="hidden mt-4 sm:mt-6 bg-gradient-to-b from-[#001736] via-[#051126] to-black rounded-3xl p-3 sm:p-6 border border-cyan-500/40 shadow-2xl relative overflow-hidden transition-all duration-300">
    
    <!-- Barra Superior de la Cámara -->
    <div class="flex items-center justify-between mb-3 text-white gap-2">
      <div class="flex items-center gap-2 min-w-0">
        <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-pulse shrink-0"></span>
        <span class="text-xs sm:text-sm font-black font-heading tracking-wide uppercase text-cyan-200 truncate">Cámara SENATI</span>
        <span id="camera-res-badge" class="hidden xs:inline-block text-[10px] px-2 py-0.5 rounded-full bg-cyan-500/20 text-cyan-300 font-mono border border-cyan-500/30 shrink-0">HD</span>
      </div>
      
      <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
        <!-- Temporizador 0s / 3s -->
        <button 
          type="button" 
          id="btn-camera-timer" 
          class="flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-white/10 hover:bg-white/20 active:scale-95 text-white text-xs font-bold transition-all cursor-pointer border border-white/15"
          title="Temporizador de disparo"
        >
          <span id="camera-timer-icon">⏱️</span>
          <span id="camera-timer-label">0s</span>
        </button>

        <!-- Alternar Cámara Frontal / Trasera -->
        <button 
          type="button" 
          id="btn-flip-camera" 
          class="flex items-center gap-1 sm:gap-1.5 px-2.5 sm:px-3 py-1.5 rounded-xl bg-white/10 hover:bg-white/20 active:scale-95 text-white text-xs font-bold transition-all cursor-pointer border border-white/15"
          title="Cambiar entre cámara trasera y frontal"
        >
          <svg class="w-4 h-4 text-cyan-300 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
          </svg>
          <span class="hidden sm:inline">Girar Lente</span>
        </button>

        <!-- Cerrar Cámara -->
        <button 
          type="button" 
          id="btn-close-camera" 
          class="p-1.5 sm:px-3 sm:py-1.5 rounded-xl bg-red-500/20 hover:bg-red-500/30 text-red-300 hover:text-white text-xs font-bold transition-all cursor-pointer border border-red-500/30"
        >
          ✕ Salir
        </button>
      </div>
    </div>

    <!-- Visor de Cámara con Guías de Encuadre -->
    <div id="camera-viewport-wrapper" class="relative w-full max-w-3xl mx-auto rounded-2xl overflow-hidden shadow-[0_0_60px_rgba(0,163,224,0.25)] border-2 border-cyan-400/50 bg-black flex items-center justify-center transition-all duration-300 aspect-[4/3] sm:aspect-video max-h-[55vh]">
      
      <video id="camera-video-feed" autoplay playsinline muted class="w-full h-full object-cover transform scale-x-1 transition-all duration-300"></video>
      <canvas id="camera-capture-canvas" class="hidden"></canvas>

      <!-- Destello de Obturador -->
      <div id="camera-shutter-flash" class="absolute inset-0 bg-white opacity-0 pointer-events-none transition-opacity duration-150 z-30"></div>

      <!-- Cuenta regresiva visual (3, 2, 1) -->
      <div id="camera-countdown-big" class="hidden absolute inset-0 z-40 bg-black/60 backdrop-blur-xs flex items-center justify-center">
        <span id="camera-countdown-number" class="text-7xl sm:text-8xl font-heading font-black text-white drop-shadow-[0_0_30px_rgba(0,163,224,1)] animate-bounce">3</span>
      </div>

      <!-- Guías de Encuadre en las 4 esquinas -->
      <div class="absolute inset-3 sm:inset-4 pointer-events-none z-10 flex flex-col justify-between">
        <div class="flex justify-between">
          <div class="w-6 h-6 sm:w-7 sm:h-7 border-t-2 border-l-2 border-cyan-400 rounded-tl-lg shadow-[0_0_10px_rgba(0,163,224,0.5)]"></div>
          <div class="w-6 h-6 sm:w-7 sm:h-7 border-t-2 border-r-2 border-cyan-400 rounded-tr-lg shadow-[0_0_10px_rgba(0,163,224,0.5)]"></div>
        </div>
        <div class="flex justify-between">
          <div class="w-6 h-6 sm:w-7 sm:h-7 border-b-2 border-l-2 border-cyan-400 rounded-bl-lg shadow-[0_0_10px_rgba(0,163,224,0.5)]"></div>
          <div class="w-6 h-6 sm:w-7 sm:h-7 border-b-2 border-r-2 border-cyan-400 rounded-br-lg shadow-[0_0_10px_rgba(0,163,224,0.5)]"></div>
        </div>
      </div>

      <!-- Barra de Progreso de Grabación de Video de 8 Segundos -->
      <div id="countdown-overlay" class="hidden absolute top-3 left-3 right-3 sm:top-4 sm:left-4 sm:right-4 z-20 flex items-center justify-between bg-black/85 backdrop-blur-md px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-2xl border border-red-500/50 shadow-xl">
        <div class="flex items-center gap-1.5 text-red-400 font-bold text-xs shrink-0">
          <span class="w-2.5 h-2.5 rounded-full bg-red-500 animate-ping"></span>
          <span class="font-mono tracking-wider text-[11px] sm:text-xs">GRABANDO</span>
        </div>
        <div class="flex-1 mx-3 bg-white/20 h-2 sm:h-2.5 rounded-full overflow-hidden">
          <div id="video-record-progress-bar" class="h-full bg-gradient-to-r from-amber-400 to-red-500 transition-all duration-100 ease-linear shadow-[0_0_10px_rgba(239,68,68,0.8)]" style="width: 100%;"></div>
        </div>
        <span class="text-white font-mono font-black text-xs sm:text-sm shrink-0"><strong id="countdown-seconds">8.0</strong>s</span>
      </div>
    </div>

    <!-- Selector de Modo (FOTO vs VIDEO 8s) y Disparador Central -->
    <div class="mt-4 flex flex-col items-center gap-3">
      
      <!-- Pestañas de modo -->
      <div class="flex items-center bg-white/10 p-1 rounded-2xl border border-white/15 shadow-inner">
        <button 
          type="button" 
          id="mode-tab-photo" 
          class="px-5 sm:px-6 py-1.5 sm:py-2 rounded-xl text-xs font-black uppercase tracking-wider transition-all cursor-pointer bg-cyan-500 text-white shadow-md flex items-center gap-1.5"
        >
          <span>📸</span>
          <span>Foto</span>
        </button>
        <button 
          type="button" 
          id="mode-tab-video" 
          class="px-5 sm:px-6 py-1.5 sm:py-2 rounded-xl text-xs font-black uppercase tracking-wider transition-all cursor-pointer text-white/70 hover:text-white flex items-center gap-1.5"
        >
          <span>🎥</span>
          <span>Video (8s)</span>
        </button>
      </div>

      <!-- Disparador Central Grande (Shutter Button) -->
      <div class="flex items-center justify-center my-0.5">
        <!-- Disparador de FOTO -->
        <button 
          type="button" 
          id="btn-shutter-photo" 
          class="group relative w-16 h-16 sm:w-20 sm:h-20 rounded-full border-4 border-white flex items-center justify-center active:scale-95 transition-all cursor-pointer shadow-[0_0_30px_rgba(255,255,255,0.5)] hover:border-cyan-300"
          title="Tomar fotografía"
        >
          <div class="w-12 h-12 sm:w-15 sm:h-15 rounded-full bg-white group-hover:scale-95 group-active:scale-90 transition-transform shadow-inner"></div>
        </button>

        <!-- Disparador de VIDEO (8s) -->
        <button 
          type="button" 
          id="btn-shutter-video" 
          class="hidden group relative w-16 h-16 sm:w-20 sm:h-20 rounded-full border-4 border-red-500 flex items-center justify-center active:scale-95 transition-all cursor-pointer shadow-[0_0_35px_rgba(239,68,68,0.6)]"
          title="Iniciar o detener grabación de 8 segundos"
        >
          <div id="video-shutter-inner" class="w-12 h-12 sm:w-15 sm:h-15 rounded-full bg-red-600 transition-all group-hover:scale-95"></div>
        </button>
      </div>
      <p id="camera-shutter-hint" class="text-xs text-cyan-200/80 font-medium text-center">
        Toca para capturar tu mejor fotografía
      </p>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════
       PREVISUALIZACIÓN DIRECTA + BOTÓN DE TRANSMITIR
       (SIN FILTROS NI RECORTES, 100% ADAPTADA A PANTALLAS PEQUEÑAS)
  ═══════════════════════════════════════════════════════════════════ -->
  <div id="preview-panel" class="hidden mt-4 sm:mt-6 bg-slate-50 border border-slate-200 rounded-3xl p-3.5 sm:p-6 shadow-sm animate-in fade-in duration-200">
    <!-- Barra superior de la vista previa -->
    <div class="flex items-center justify-between mb-3 sm:mb-4 pb-2.5 sm:pb-3 border-b border-slate-200 gap-2">
      <div class="flex items-center gap-2 min-w-0">
        <span class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-emerald-500 animate-pulse shrink-0"></span>
        <h4 id="preview-title" class="font-heading font-black text-slate-800 text-sm sm:text-lg truncate">
          Foto Lista para Transmitir
        </h4>
      </div>
      <button 
        type="button"
        id="btn-discard-preview" 
        class="text-xs text-red-600 hover:text-red-700 font-bold cursor-pointer px-2.5 sm:px-3 py-1.5 rounded-xl hover:bg-red-50 border border-transparent hover:border-red-200 transition-all shrink-0 flex items-center gap-1"
      >
        <span>✕</span>
        <span>Cambiar foto</span>
      </button>
    </div>

    <!-- Contenido Principal: Grid adaptativo -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 sm:gap-6 items-center">
      
      <!-- Visor de la Foto o Video (adaptado a pantallas chicas, no se corta ni deforma) -->
      <div class="md:col-span-7 relative w-full rounded-2xl overflow-hidden shadow-lg bg-slate-950 border border-slate-300 flex items-center justify-center min-h-[220px] max-h-[50vh] sm:max-h-[58vh]">
        <img 
          id="preview-image-element" 
          src="" 
          alt="Vista previa de foto" 
          class="w-full h-full max-h-[50vh] sm:max-h-[58vh] object-contain transition-all" 
        />
        <video 
          id="preview-video-element" 
          src="" 
          controls 
          playsinline 
          class="w-full h-full max-h-[50vh] sm:max-h-[58vh] object-contain hidden"
        ></video>
      </div>

      <!-- Controles y Botón de Transmisión Directa -->
      <div class="md:col-span-5 flex flex-col justify-center space-y-3.5 sm:space-y-4">
        
        <!-- Tarjeta Informativa del Asistente -->
        <div class="p-3.5 sm:p-4 rounded-2xl bg-white border border-slate-200/80 shadow-xs space-y-2">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-[#002855] to-[#00A3E0] text-white flex items-center justify-center font-black text-sm shrink-0">
              <span id="preview-user-initial">S</span>
            </div>
            <div class="min-w-0 flex-1">
              <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider block">Transmitiendo como</span>
              <p id="preview-user-name" class="font-heading font-black text-sm sm:text-base text-[#002855] truncate">
                Asistente SENATI
              </p>
            </div>
            <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 shrink-0">
              En Vivo
            </span>
          </div>

          <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
            <span class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-[#00A3E0]"></span>
              <span id="preview-media-type-label">Fotografía Original HD</span>
            </span>
            <span class="font-mono text-[11px] text-slate-400">Pantalla Gigante</span>
          </div>
        </div>

        <!-- Mensaje de confirmación inmediata -->
        <div class="p-3 rounded-xl bg-sky-50 border border-sky-200 text-[#002855] text-xs">
          <p class="leading-relaxed text-slate-600 text-[11px] sm:text-xs">
            ¡Tu foto se enviará tal como la capturaste, en alta resolución y en tiempo real a la transmisión del evento!
          </p>
        </div>

        <!-- BOTÓN PRINCIPAL DE TRANSMISIÓN (GRANDE Y FÁCIL DE TOCAR EN MÓVIL) -->
        <button 
          type="button" 
          id="btn-confirm-upload" 
          class="w-full btn-bubble-senati text-white font-heading font-black text-sm sm:text-base py-3.5 sm:py-4 px-5 sm:px-6 rounded-2xl uppercase tracking-wider flex items-center justify-center gap-2 cursor-pointer shadow-lg shadow-sky-600/25 active:scale-[0.98] transition-all min-h-[50px] sm:min-h-[54px]"
        >
          <span>Transmitir a la Pantalla Gigante</span>
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </button>

        <!-- Botón secundario para descartar / cambiar en móvil -->
        <button
          type="button"
          id="btn-cancel-preview-bottom"
          class="w-full py-2.5 px-4 text-xs font-bold text-slate-500 hover:text-slate-800 bg-white hover:bg-slate-100 rounded-xl border border-slate-200 transition-colors cursor-pointer text-center"
        >
          Tomar otra foto o cambiar archivo
        </button>
      </div>

    </div>
  </div>
</div>

<script>
  import confetti from 'canvas-confetti';
  import { galleryStore } from '../lib/store';
  import { uploadMediaToSupabase } from '../lib/supabase';
  import type { MediaType } from '../lib/types';

  // ── Elementos DOM ──
  const methodsContainer    = document.getElementById('upload-methods-container');
  const btnCamera           = document.getElementById('btn-open-camera');
  const cameraFallbackInput = document.getElementById('camera-fallback-input') as HTMLInputElement;
  const cameraPhotoInput    = document.getElementById('camera-photo-input') as HTMLInputElement;
  const cameraVideoInput    = document.getElementById('camera-video-input') as HTMLInputElement;
  const fileGalleryInput    = document.getElementById('file-gallery-input') as HTMLInputElement;

  // ── Elementos del Modal Selector de Cámara ──
  const cameraModeModal     = document.getElementById('camera-mode-modal');
  const btnCloseModeModal   = document.getElementById('btn-close-mode-modal');
  const btnCancelModeModal  = document.getElementById('btn-cancel-mode-modal');
  const btnSelectModePhoto  = document.getElementById('btn-select-mode-photo');
  const btnSelectModeVideo  = document.getElementById('btn-select-mode-video');
  const btnSelectModeWebcam = document.getElementById('btn-select-mode-webcam');

  // ── Elementos de Cámara WebRTC ──
  const cameraModal         = document.getElementById('camera-modal');
  const cameraVideo         = document.getElementById('camera-video-feed') as HTMLVideoElement;
  const cameraCanvas        = document.getElementById('camera-capture-canvas') as HTMLCanvasElement;
  const cameraFlash         = document.getElementById('camera-shutter-flash')!;
  const btnCloseCamera      = document.getElementById('btn-close-camera');
  const btnFlipCamera       = document.getElementById('btn-flip-camera');
  const btnCameraTimer      = document.getElementById('btn-camera-timer');
  const cameraTimerLabel    = document.getElementById('camera-timer-label')!;
  const countdownBig        = document.getElementById('camera-countdown-big')!;
  const countdownBigNumber  = document.getElementById('camera-countdown-number')!;
  const modeTabPhoto        = document.getElementById('mode-tab-photo')!;
  const modeTabVideo        = document.getElementById('mode-tab-video')!;
  const btnShutterPhoto     = document.getElementById('btn-shutter-photo')!;
  const btnShutterVideo     = document.getElementById('btn-shutter-video')!;
  const countdownOverlay    = document.getElementById('countdown-overlay')!;
  const countdownSeconds    = document.getElementById('countdown-seconds')!;
  const videoRecordBar      = document.getElementById('video-record-progress-bar')!;
  const cameraShutterHint   = document.getElementById('camera-shutter-hint')!;

  // ── Elementos de Previsualización y Envío Directo ──
  const previewPanel        = document.getElementById('preview-panel');
  const previewImg          = document.getElementById('preview-image-element') as HTMLImageElement;
  const previewVideo        = document.getElementById('preview-video-element') as HTMLVideoElement;
  const previewTitle        = document.getElementById('preview-title');
  const btnDiscard          = document.getElementById('btn-discard-preview');
  const btnCancelBottom     = document.getElementById('btn-cancel-preview-bottom');
  const btnConfirm          = document.getElementById('btn-confirm-upload') as HTMLButtonElement;
  const previewUserName     = document.getElementById('preview-user-name');
  const previewUserInitial  = document.getElementById('preview-user-initial');
  const previewMediaTypeLbl = document.getElementById('preview-media-type-label');

  // ── Estado ──
  let mediaStream: MediaStream | null = null;
  let mediaRecorder: MediaRecorder | null = null;
  let recordedChunks: Blob[] = [];
  let recordTimer: any = null;
  let recordStartTime = 0;
  let currentFacingMode: 'environment' | 'user' = 'environment';
  let activeCameraMode: 'photo' | 'video' = 'photo';
  let cameraTimerSeconds = 0; // 0s o 3s
  let isTimerRunning = false;

  let currentFile: File | Blob | null = null;
  let currentMediaUrl: string | null = null;
  let currentMediaType: MediaType = 'image';
  let currentSource: 'camera' | 'upload' = 'upload';
  let videoDuration: number | undefined = undefined;
  let currentVideoThumbnail: string | null = null;

  // ── Sonido y Vibración de Disparador ──
  function triggerShutterFeedback() {
    try {
      const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
      if (AudioCtx) {
        const ctx = new AudioCtx();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(800, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(120, ctx.currentTime + 0.08);
        gain.gain.setValueAtTime(0.3, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.08);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.08);
      }
    } catch {}

    try {
      if ('vibrate' in navigator) {
        navigator.vibrate([40, 20, 60]);
      }
    } catch {}
  }

  // ── Temporizador (0s / 3s) ──
  btnCameraTimer?.addEventListener('click', () => {
    cameraTimerSeconds = cameraTimerSeconds === 0 ? 3 : 0;
    cameraTimerLabel.textContent = `${cameraTimerSeconds}s`;
    btnCameraTimer.className = cameraTimerSeconds > 0
      ? 'flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-cyan-500 text-white text-xs font-bold transition-all cursor-pointer shadow-xs'
      : 'flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-white/10 hover:bg-white/20 active:scale-95 text-white text-xs font-bold transition-all cursor-pointer border border-white/15';
  });

  // ═══════════════════════════════════════════════════════════════════
  //  MODAL SELECTOR DE CÁMARA (FOTO NATIVA / VIDEO NATIVO / VISOR WEB)
  // ═══════════════════════════════════════════════════════════════════
  function triggerNativeInput(input: HTMLInputElement | null) {
    if (!input) return;
    input.value = '';
    input.click();
  }

  function openCameraModeModal() {
    cameraModeModal?.classList.remove('hidden');
  }

  function closeCameraModeModal() {
    cameraModeModal?.classList.add('hidden');
  }

  btnCamera?.addEventListener('click', openCameraModeModal);
  btnCloseModeModal?.addEventListener('click', closeCameraModeModal);
  btnCancelModeModal?.addEventListener('click', closeCameraModeModal);
  cameraModeModal?.addEventListener('click', (e) => {
    if (e.target === cameraModeModal) {
      closeCameraModeModal();
    }
  });

  btnSelectModePhoto?.addEventListener('click', () => {
    closeCameraModeModal();
    activeCameraMode = 'photo';
    const isMobile = /Mobi|Android|iPhone|iPad|iPod/i.test(navigator.userAgent) ||
      (navigator.maxTouchPoints > 1 && !window.matchMedia('(pointer: fine)').matches);

    if (isMobile && cameraPhotoInput) {
      triggerNativeInput(cameraPhotoInput);
    } else {
      openWebRtcCamera('photo');
    }
  });

  btnSelectModeVideo?.addEventListener('click', () => {
    closeCameraModeModal();
    activeCameraMode = 'video';
    const isMobile = /Mobi|Android|iPhone|iPad|iPod/i.test(navigator.userAgent) ||
      (navigator.maxTouchPoints > 1 && !window.matchMedia('(pointer: fine)').matches);

    if (isMobile && cameraVideoInput) {
      triggerNativeInput(cameraVideoInput);
    } else {
      openWebRtcCamera('video');
    }
  });

  btnSelectModeWebcam?.addEventListener('click', () => {
    closeCameraModeModal();
    openWebRtcCamera(activeCameraMode || 'photo');
  });

  async function openWebRtcCamera(mode: 'photo' | 'video' = 'photo') {
    activeCameraMode = mode;
    if (mode === 'video') {
      modeTabVideo?.click();
    } else {
      modeTabPhoto?.click();
    }
    await startCameraStream();
  }

  // ═══════════════════════════════════════════════════════════════════
  //  CÁMARA WEBRTC: getUserMedia CON RESOLUCIÓN NATIVA Y CAMBIO DE LENTE
  // ═══════════════════════════════════════════════════════════════════
  async function startCameraStream() {
    if (mediaStream) {
      mediaStream.getTracks().forEach(track => track.stop());
      mediaStream = null;
    }

    try {
      mediaStream = await navigator.mediaDevices.getUserMedia({
        video: {
          facingMode: { ideal: currentFacingMode },
          width: { ideal: 1920, max: 2560 },
          height: { ideal: 1080, max: 1440 },
          frameRate: { ideal: 30, max: 60 }
        },
        audio: { echoCancellation: true, noiseSuppression: true }
      });

      if (cameraVideo) {
        cameraVideo.srcObject = mediaStream;
        cameraVideo.style.transform = currentFacingMode === 'user' ? 'scaleX(-1)' : 'scaleX(1)';
        cameraVideo.style.filter = 'none';
        await cameraVideo.play();
      }

      cameraModal?.classList.remove('hidden');
      methodsContainer?.classList.add('hidden');
    } catch (err) {
      console.warn('getUserMedia no disponible, activando input nativo:', err);
      triggerNativeInput(activeCameraMode === 'video' ? cameraVideoInput : cameraPhotoInput);
    }
  }

  btnFlipCamera?.addEventListener('click', async () => {
    currentFacingMode = currentFacingMode === 'environment' ? 'user' : 'environment';
    await startCameraStream();
  });

  function stopCamera() {
    stopRecording();
    if (mediaStream) {
      mediaStream.getTracks().forEach((track) => track.stop());
      mediaStream = null;
    }
    cameraModal?.classList.add('hidden');
    methodsContainer?.classList.remove('hidden');
  }

  btnCloseCamera?.addEventListener('click', stopCamera);

  // ── Pestañas de Modo (Foto vs Video 8s) ──
  modeTabPhoto?.addEventListener('click', () => {
    activeCameraMode = 'photo';
    modeTabPhoto.className = 'px-5 sm:px-6 py-1.5 sm:py-2 rounded-xl text-xs font-black uppercase tracking-wider transition-all cursor-pointer bg-cyan-500 text-white shadow-md flex items-center gap-1.5';
    modeTabVideo.className = 'px-5 sm:px-6 py-1.5 sm:py-2 rounded-xl text-xs font-black uppercase tracking-wider transition-all cursor-pointer text-white/70 hover:text-white flex items-center gap-1.5';
    btnShutterPhoto.classList.remove('hidden');
    btnShutterVideo.classList.add('hidden');
    cameraShutterHint.textContent = 'Toca para capturar tu fotografía';
  });

  modeTabVideo?.addEventListener('click', () => {
    activeCameraMode = 'video';
    modeTabVideo.className = 'px-5 sm:px-6 py-1.5 sm:py-2 rounded-xl text-xs font-black uppercase tracking-wider transition-all cursor-pointer bg-red-600 text-white shadow-md flex items-center gap-1.5';
    modeTabPhoto.className = 'px-5 sm:px-6 py-1.5 sm:py-2 rounded-xl text-xs font-black uppercase tracking-wider transition-all cursor-pointer text-white/70 hover:text-white flex items-center gap-1.5';
    btnShutterVideo.classList.remove('hidden');
    btnShutterPhoto.classList.add('hidden');
    cameraShutterHint.textContent = 'Toca para grabar un clip de hasta 8 segundos';
  });

  // ── Tomar Foto con Temporizador (Sin filtros) ──
  btnShutterPhoto?.addEventListener('click', () => {
    if (isTimerRunning) return;

    if (cameraTimerSeconds > 0) {
      isTimerRunning = true;
      countdownBig.classList.remove('hidden');
      let count = cameraTimerSeconds;
      countdownBigNumber.textContent = String(count);

      const interval = setInterval(() => {
        count--;
        if (count > 0) {
          countdownBigNumber.textContent = String(count);
        } else {
          clearInterval(interval);
          countdownBig.classList.add('hidden');
          isTimerRunning = false;
          executePhotoCapture();
        }
      }, 1000);
    } else {
      executePhotoCapture();
    }
  });

  function executePhotoCapture() {
    if (!cameraVideo || !cameraCanvas) return;

    triggerShutterFeedback();

    // Efecto de flash visual
    cameraFlash.style.opacity = '0.9';
    setTimeout(() => { cameraFlash.style.opacity = '0'; }, 150);

    const w = cameraVideo.videoWidth || 1280;
    const h = cameraVideo.videoHeight || 720;
    cameraCanvas.width = w;
    cameraCanvas.height = h;

    const ctx = cameraCanvas.getContext('2d');
    if (ctx) {
      if (currentFacingMode === 'user') {
        ctx.translate(w, 0);
        ctx.scale(-1, 1);
      }
      ctx.drawImage(cameraVideo, 0, 0, w, h);

      currentMediaUrl = cameraCanvas.toDataURL('image/webp', 0.90);
      cameraCanvas.toBlob((blob) => {
        if (blob) {
          currentFile = new File([blob], `photo_${Date.now()}.webp`, { type: 'image/webp' });
        }
      }, 'image/webp', 0.90);

      currentMediaType = 'image';
      currentSource = 'camera';
      videoDuration = undefined;

      stopCamera();
      showPreview();
    }
  }

  // ── Grabar Video de 8 Segundos ──
  btnShutterVideo?.addEventListener('click', () => {
    if (mediaRecorder && mediaRecorder.state === 'recording') {
      stopRecording();
      return;
    }
    startRecording();
  });

  function startRecording() {
    if (!mediaStream) return;
    recordedChunks = [];
    recordStartTime = Date.now();
    triggerShutterFeedback();

    const mime = MediaRecorder.isTypeSupported('video/webm;codecs=vp9')
      ? 'video/webm;codecs=vp9'
      : (MediaRecorder.isTypeSupported('video/webm') ? 'video/webm' : 'video/mp4');

    try {
      mediaRecorder = new MediaRecorder(mediaStream, { mimeType: mime });
    } catch {
      mediaRecorder = new MediaRecorder(mediaStream);
    }

    mediaRecorder.ondataavailable = (e) => {
      if (e.data.size > 0) recordedChunks.push(e.data);
    };

    mediaRecorder.onstop = () => {
      triggerShutterFeedback();
      const blob = new Blob(recordedChunks, { type: 'video/webm' });
      currentFile = new File([blob], `video_${Date.now()}.webm`, { type: 'video/webm' });
      const elapsed = Math.min(8.0, Number(((Date.now() - recordStartTime) / 1000).toFixed(1)));
      videoDuration = elapsed;

      const reader = new FileReader();
      reader.onload = (e) => {
        currentMediaUrl = e.target?.result as string;
        currentMediaType = 'video';
        currentSource = 'camera';
        stopCamera();
        showPreview();
      };
      reader.readAsDataURL(blob);
    };

    mediaRecorder.start(100);
    countdownOverlay.classList.remove('hidden');

    const maxMs = 8000;
    recordTimer = setInterval(() => {
      const elapsedMs = Date.now() - recordStartTime;
      const leftSec = Math.max(0, (maxMs - elapsedMs) / 1000);
      countdownSeconds.textContent = leftSec.toFixed(1);
      const pct = Math.max(0, 100 - (elapsedMs / maxMs) * 100);
      videoRecordBar.style.width = `${pct}%`;

      if (elapsedMs >= maxMs) {
        stopRecording();
      }
    }, 50);
  }

  function stopRecording() {
    if (recordTimer) {
      clearInterval(recordTimer);
      recordTimer = null;
    }
    countdownOverlay.classList.add('hidden');
    if (mediaRecorder && mediaRecorder.state === 'recording') {
      mediaRecorder.stop();
    }
  }

  // ═══════════════════════════════════════════════════════════════════
  //  SELECCIÓN DESDE GALERÍA / ARCHIVOS
  // ═══════════════════════════════════════════════════════════════════
  function handleSelectedFile(file: File, source: 'upload' | 'camera') {
    if (!file) return;

    currentFile = file;
    const isVideo = file.type.startsWith('video/') || /\.(mp4|webm|mov|m4v|3gp|avi)$/i.test(file.name);

    if (currentMediaUrl && currentMediaUrl.startsWith('blob:')) {
      try { URL.revokeObjectURL(currentMediaUrl); } catch {}
    }

    const objectUrl = URL.createObjectURL(file);
    currentMediaUrl = objectUrl;
    currentSource = source;

    if (isVideo) {
      currentMediaType = 'video';
      const tempVideo = document.createElement('video');
      tempVideo.preload = 'metadata';
      tempVideo.src = objectUrl;

      let isReady = false;
      const onVideoReady = () => {
        if (isReady) return;
        isReady = true;
        videoDuration = Math.min(8.0, tempVideo.duration || 8);
        showPreview();
      };

      tempVideo.onloadeddata = () => {
        tempVideo.currentTime = 0.05;
      };

      tempVideo.onseeked = () => {
        try {
          const cvs = document.createElement('canvas');
          const maxDim = 640;
          let w = tempVideo.videoWidth || 640;
          let h = tempVideo.videoHeight || 360;
          if (w > maxDim || h > maxDim) {
            if (w > h) {
              h = Math.round((h * maxDim) / w);
              w = maxDim;
            } else {
              w = Math.round((w * maxDim) / h);
              h = maxDim;
            }
          }
          cvs.width = w;
          cvs.height = h;
          const ctx = cvs.getContext('2d');
          if (ctx) {
            ctx.drawImage(tempVideo, 0, 0, w, h);
            currentVideoThumbnail = cvs.toDataURL('image/jpeg', 0.85);
          }
        } catch (e) {
          console.warn('Extracción de thumbnail video:', e);
        }
      };

      tempVideo.onloadedmetadata = onVideoReady;
      tempVideo.onerror = () => {
        if (isReady) return;
        isReady = true;
        videoDuration = 8;
        showPreview();
      };

      setTimeout(() => {
        if (!isReady) onVideoReady();
      }, 500);
    } else {
      currentMediaType = 'image';
      videoDuration = undefined;
      showPreview();
    }
  }

  fileGalleryInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) handleSelectedFile(file, 'upload');
  });

  cameraFallbackInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) handleSelectedFile(file, 'camera');
  });

  cameraPhotoInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) handleSelectedFile(file, 'camera');
  });

  cameraVideoInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) handleSelectedFile(file, 'camera');
  });

  // ═══════════════════════════════════════════════════════════════════
  //  PREVISUALIZACIÓN INMEDIATA (DIRECTA AL BOTÓN DE TRANSMITIR)
  // ═══════════════════════════════════════════════════════════════════
  function showPreview() {
    if (!currentMediaUrl || !previewPanel) return;

    // Actualizar datos del usuario logueado en la tarjeta
    const session = galleryStore.getSession();
    const currentName = session?.name || 'Asistente SENATI';
    if (previewUserName) previewUserName.textContent = currentName;
    if (previewUserInitial) previewUserInitial.textContent = currentName.charAt(0).toUpperCase();

    if (currentMediaType === 'video') {
      if (previewImg) previewImg.classList.add('hidden');
      if (previewVideo) {
        previewVideo.classList.remove('hidden');
        previewVideo.src = currentMediaUrl;
        previewVideo.play().catch(() => {});
      }
      if (previewTitle) previewTitle.textContent = 'Video Listo para Transmitir';
      if (previewMediaTypeLbl) previewMediaTypeLbl.textContent = `Clip de Video (${videoDuration || 8}s)`;
    } else {
      if (previewVideo) {
        previewVideo.pause();
        previewVideo.classList.add('hidden');
      }
      if (previewImg) {
        previewImg.classList.remove('hidden');
        previewImg.src = currentMediaUrl;
        previewImg.style.filter = 'none';
        previewImg.style.transform = 'none';
      }
      if (previewTitle) previewTitle.textContent = 'Foto Lista para Transmitir';
      if (previewMediaTypeLbl) previewMediaTypeLbl.textContent = 'Fotografía Original HD';
    }

    previewPanel.classList.remove('hidden');
    methodsContainer?.classList.add('hidden');

    // Desplazar suavemente a la vista previa
    setTimeout(() => {
      previewPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 100);
  }

  /**
   * Comprime cualquier imagen a WebP de alta fidelidad (máx 1920px, 85% calidad)
   * Sin filtros ni alteraciones artificiales
   */
  async function compressImageToWebP(file: File | Blob): Promise<File> {
    return new Promise((resolve) => {
      const img = new Image();
      const url = URL.createObjectURL(file);
      img.onload = () => {
        URL.revokeObjectURL(url);
        const canvas = document.createElement('canvas');
        const maxDim = 1920;
        let w = img.width;
        let h = img.height;
        if (w > maxDim || h > maxDim) {
          if (w > h) {
            h = Math.round((h * maxDim) / w);
            w = maxDim;
          } else {
            w = Math.round((w * maxDim) / h);
            h = maxDim;
          }
        }
        canvas.width = w;
        canvas.height = h;
        const ctx = canvas.getContext('2d');
        if (ctx) {
          ctx.drawImage(img, 0, 0, w, h);
          canvas.toBlob((blob) => {
            if (blob) {
              const webpFile = new File([blob], `senati_${Date.now()}.webp`, {
                type: 'image/webp',
                lastModified: Date.now()
              });
              resolve(webpFile);
            } else {
              resolve(file instanceof File ? file : new File([file], `senati_${Date.now()}.jpg`, { type: 'image/jpeg' }));
            }
          }, 'image/webp', 0.85);
        } else {
          resolve(file instanceof File ? file : new File([file], `senati_${Date.now()}.jpg`, { type: 'image/jpeg' }));
        }
      };
      img.onerror = () => {
        URL.revokeObjectURL(url);
        resolve(file instanceof File ? file : new File([file], `senati_${Date.now()}.jpg`, { type: 'image/jpeg' }));
      };
      img.src = url;
    });
  }

  async function compressImageForOffline(file: File | Blob): Promise<string> {
    return new Promise((resolve) => {
      const img = new Image();
      const url = URL.createObjectURL(file);
      img.onload = () => {
        URL.revokeObjectURL(url);
        const canvas = document.createElement('canvas');
        const maxDim = 1280;
        let w = img.width;
        let h = img.height;
        if (w > maxDim || h > maxDim) {
          if (w > h) {
            h = Math.round((h * maxDim) / w);
            w = maxDim;
          } else {
            w = Math.round((w * maxDim) / h);
            h = maxDim;
          }
        }
        canvas.width = w;
        canvas.height = h;
        const ctx = canvas.getContext('2d');
        if (ctx) {
          ctx.drawImage(img, 0, 0, w, h);
          resolve(canvas.toDataURL('image/webp', 0.8));
        } else {
          resolve(url);
        }
      };
      img.onerror = () => {
        URL.revokeObjectURL(url);
        resolve(currentMediaUrl || '');
      };
      img.src = url;
    });
  }

  function resetUploadPreview() {
    if (currentMediaUrl && currentMediaUrl.startsWith('blob:')) {
      try { URL.revokeObjectURL(currentMediaUrl); } catch {}
    }
    currentMediaUrl = null;
    currentFile = null;
    previewPanel?.classList.add('hidden');
    methodsContainer?.classList.remove('hidden');
    if (previewVideo) previewVideo.pause();
    if (fileGalleryInput) fileGalleryInput.value = '';
    if (cameraFallbackInput) cameraFallbackInput.value = '';
    if (cameraPhotoInput) cameraPhotoInput.value = '';
    if (cameraVideoInput) cameraVideoInput.value = '';

    if (btnConfirm) {
      btnConfirm.disabled = false;
      btnConfirm.innerHTML = `
        <span>Transmitir a la Pantalla Gigante</span>
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      `;
    }
  }

  btnDiscard?.addEventListener('click', resetUploadPreview);
  btnCancelBottom?.addEventListener('click', resetUploadPreview);

  // ═══════════════════════════════════════════════════════════════════
  //  TRANSMISIÓN DEFINITIVA A LA PANTALLA GIGANTE
  // ═══════════════════════════════════════════════════════════════════
  btnConfirm?.addEventListener('click', async () => {
    if (!currentMediaUrl && !currentFile) return;

    if (btnConfirm) {
      btnConfirm.innerHTML = `
        <svg class="animate-spin -ml-1 mr-2 h-5 w-5 text-white inline" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
        </svg>
        <span>Transmitiendo a la Pantalla Gigante...</span>
      `;
      btnConfirm.disabled = true;
    }

    try {
      // 1. Optimizar imagen en WebP si es foto
      if (currentMediaType === 'image' && currentFile) {
        try {
          currentFile = await compressImageToWebP(currentFile);
        } catch (err) {
          console.warn('Compresión WebP:', err);
        }
      }

      const session = galleryStore.getSession();
      const userId = session?.email || session?.phone || session?.name || 'Asistente SENATI';

      let finalUrl = currentMediaUrl;
      let finalId: string | undefined = undefined;

      // 2. Subir archivo a Cloudinary / Supabase
      if (currentFile) {
        try {
          const uploadResult = await uploadMediaToSupabase(
            currentFile,
            userId,
            currentMediaType,
            videoDuration
          );

          if (uploadResult && uploadResult.publicUrl) {
            finalUrl = uploadResult.publicUrl;
            finalId = uploadResult.dbId;
          }
        } catch (err: any) {
          console.warn('Subida multimedia con advertencia:', err);
          if (currentMediaType === 'image') {
            try {
              finalUrl = await compressImageForOffline(currentFile);
            } catch {}
          }
          if (err?.message?.includes('Cloudinary')) {
            alert(`⚠️ Cloudinary: ${err.message}. Verifica tu Cloud Name y Upload Preset.`);
          } else if (err?.message?.includes('Bucket not found') || err?.message?.includes('row-level security') || err?.message?.includes('Storage:')) {
            alert(`⚠️ Aviso: La foto se transmitió localmente. En Supabase falta crear el bucket o configurar Cloudinary.`);
          }
        }
      }

      let videoThumbnailUrl: string | undefined = undefined;
      if (currentMediaType === 'video') {
        if (finalUrl && finalUrl.includes('cloudinary.com')) {
          videoThumbnailUrl = finalUrl.replace(/\.[a-zA-Z0-9]+$/, '.jpg');
        } else if (currentVideoThumbnail) {
          videoThumbnailUrl = currentVideoThumbnail;
        }
      }

      // 3. Agregar a la tienda de eventos y notificar a la pantalla gigante
      if (finalUrl) {
        galleryStore.addPhoto({
          id: finalId,
          url: finalUrl,
          mediaType: currentMediaType,
          durationSeconds: videoDuration,
          thumbnailUrl: videoThumbnailUrl,
          source: currentSource,
          author: userId,
          uploaderDeviceId: galleryStore.getDeviceId()
        });
      }

      // Celebración visual con confeti
      try {
        confetti({
          particleCount: 70,
          spread: 90,
          origin: { y: 0.6 },
          colors: ['#00A3E0', '#7C3AED', '#FFD700', '#FFFFFF']
        });
      } catch {}

      // 4. Limpiar y desplazar a la galería en vivo
      resetUploadPreview();

      const feed = document.getElementById('photo-wall-grid');
      feed?.scrollIntoView({ behavior: 'smooth' });

    } catch (unexpectedErr: any) {
      console.error('Error durante la transmisión:', unexpectedErr);
      alert('Ocurrió un error al procesar el archivo. Por favor inténtalo de nuevo.');
    } finally {
      if (btnConfirm && btnConfirm.disabled) {
        btnConfirm.disabled = false;
        btnConfirm.innerHTML = `
          <span>Transmitir a la Pantalla Gigante</span>
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        `;
      }
    }
  });

  // ── Sincronización del Estado de Transmisión (Cierre de evento por Admin) ──
  function updateTransmissionUi() {
    const isLive = galleryStore.isTransmissionActive();
    const closedBanner = document.getElementById('transmission-closed-banner');
    const btnCamera = document.getElementById('btn-open-camera');
    const uploadLabel = document.querySelector('label[for="file-gallery-input"]') as HTMLElement;
    const headerLiveBadge = document.getElementById('header-live-badge');

    if (!isLive) {
      closedBanner?.classList.remove('hidden');
      btnCamera?.classList.add('hidden');
      uploadLabel?.classList.add('hidden');
      if (headerLiveBadge) {
        headerLiveBadge.className = 'inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-1 rounded-full text-[10px] sm:text-xs font-bold bg-red-50 text-red-700 border border-red-200 shadow-xs shrink-0';
        headerLiveBadge.innerHTML = '<span class="w-2 h-2 rounded-full bg-red-500"></span><span>Transmisión Finalizada</span>';
      }
    } else {
      closedBanner?.classList.add('hidden');
      btnCamera?.classList.remove('hidden');
      uploadLabel?.classList.remove('hidden');
      if (headerLiveBadge) {
        headerLiveBadge.className = 'inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-1 rounded-full text-[10px] sm:text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 shadow-xs shrink-0';
        headerLiveBadge.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span><span class="hidden sm:inline">Transmisión Activa</span><span class="sm:hidden">En Vivo</span>';
      }
    }
  }

  updateTransmissionUi();
  galleryStore.subscribe((e) => {
    if (e.type === 'TRANSMISSION_STATUS_CHANGED') {
      updateTransmissionUi();
    }
  });
</script>
