---
// PhotoUploader.astro
---

<div class="w-full bg-white rounded-3xl p-6 sm:p-8 shadow-xl shadow-slate-200/50 border border-slate-100">
  <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-100">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-[#00A3E0]/10 text-[#002855] flex items-center justify-center">
        <svg class="w-6 h-6 text-[#00A3E0]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
      </div>
      <div>
        <h3 class="font-heading font-black text-xl text-[#002855]">Subir Foto o Video Corto (8s)</h3>
        <p class="text-xs text-slate-500 font-medium">Comparte tus fotos o clips de hasta 8 segundos en la pantalla gigante</p>
      </div>
    </div>
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      Transmisión Activa
    </span>
  </div>

  <!-- Botones de Acción Inicial (Cámara vs Galería) -->
  <div id="upload-methods-container" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <!-- Opción 1: Captura de Cámara en Vivo (Foto o Video) -->
    <button 
      type="button" 
      id="btn-open-camera"
      class="group p-6 rounded-2xl border-2 border-dashed border-[#00A3E0] hover:border-[#002855] bg-sky-50/50 hover:bg-sky-50 flex flex-col items-center justify-center gap-3 transition-all cursor-pointer"
    >
      <div class="w-14 h-14 rounded-2xl bg-[#00A3E0] text-white flex items-center justify-center shadow-lg shadow-sky-400/30 group-hover:scale-110 transition-transform">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
        </svg>
      </div>
      <div class="text-center">
        <span class="font-heading font-extrabold text-[#002855] text-base block">Cámara / Grabar Video (8s)</span>
        <span class="text-xs text-slate-500">Toma una foto o graba un clip en vivo</span>
      </div>
    </button>

    <!-- Opción 2: Subir desde Galería de Archivos -->
    <label 
      for="file-gallery-input"
      class="group p-6 rounded-2xl border-2 border-dashed border-slate-300 hover:border-[#7C3AED] bg-slate-50/70 hover:bg-purple-50/40 flex flex-col items-center justify-center gap-3 transition-all cursor-pointer"
    >
      <div class="w-14 h-14 rounded-2xl bg-white border border-slate-200 text-slate-700 flex items-center justify-center shadow-md group-hover:scale-110 group-hover:text-[#7C3AED] group-hover:border-[#7C3AED]/30 transition-all">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
      </div>
      <div class="text-center">
        <span class="font-heading font-extrabold text-slate-800 group-hover:text-[#7C3AED] text-base block">Subir Foto o Video</span>
        <span class="text-xs text-slate-500">Imágenes (JPG, PNG) o Video MP4/WebM (máx 8s)</span>
      </div>
      <input 
        type="file" 
        id="file-gallery-input" 
        accept="image/*,video/mp4,video/webm,video/quicktime" 
        class="hidden"
      />
    </label>
  </div>

  <!-- Fallback móvil para captura de cámara -->
  <input 
    type="file" 
    id="camera-fallback-input" 
    accept="image/*,video/*" 
    capture="environment" 
    class="hidden"
  />

  <!-- Modal / Vista de Cámara en Vivo con getUserMedia -->
  <div id="camera-modal" class="hidden mt-6 bg-[#001736] rounded-2xl p-4 sm:p-6 border border-slate-700">
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-2 text-white">
        <span id="recording-indicator" class="w-2.5 h-2.5 rounded-full bg-red-500 animate-ping"></span>
        <span id="camera-mode-title" class="text-sm font-bold font-heading">Cámara en Vivo</span>
      </div>
      <button id="btn-close-camera" class="text-slate-400 hover:text-white text-xs font-semibold px-2.5 py-1 rounded-lg bg-white/10 cursor-pointer">
        Cancelar
      </button>
    </div>

    <!-- Video Feed con temporizador superpuesto -->
    <div class="relative w-full aspect-4/3 max-w-lg mx-auto bg-black rounded-xl overflow-hidden shadow-inner flex items-center justify-center">
      <video id="camera-video-feed" autoplay playsinline muted class="w-full h-full object-cover"></video>
      <canvas id="camera-capture-canvas" class="hidden"></canvas>

      <!-- Contador de Video de 8 Segundos -->
      <div id="countdown-overlay" class="hidden absolute top-4 right-4 bg-red-600/90 text-white font-black text-xs px-3 py-1.5 rounded-full shadow-lg flex items-center gap-2 animate-pulse">
        <span class="w-2 h-2 rounded-full bg-white"></span>
        <span>Grabando: <strong id="countdown-seconds">8</strong>s</span>
      </div>
    </div>

    <!-- Controles de Captura (Foto vs Video 8s) -->
    <div class="mt-4 flex flex-wrap items-center justify-center gap-4">
      <button 
        type="button" 
        id="btn-snap-photo" 
        class="btn-bubble-senati text-white px-6 py-3 rounded-full font-heading font-bold text-sm flex items-center gap-2 cursor-pointer"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="9" stroke-width="2"/>
          <circle cx="12" cy="12" r="4" fill="currentColor"/>
        </svg>
        <span>Tomar Foto</span>
      </button>

      <button 
        type="button" 
        id="btn-record-video" 
        class="btn-bubble-purple text-white px-6 py-3 rounded-full font-heading font-bold text-sm flex items-center gap-2 cursor-pointer"
      >
        <svg class="w-5 h-5 text-red-300" fill="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="8"/>
        </svg>
        <span id="btn-record-label">Grabar Video (8s)</span>
      </button>
    </div>
  </div>

  <!-- 2. Previsualización y Envío Inmediato (Sin campo de nombre ni mensaje) -->
  <div id="preview-panel" class="hidden mt-6 bg-slate-50 border border-slate-200 rounded-2xl p-6">
    <div class="flex items-center justify-between mb-4">
      <h4 class="font-heading font-bold text-slate-800 text-sm flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <span id="preview-title">Vista Previa</span>
      </h4>
      <button id="btn-discard-preview" class="text-xs text-red-500 hover:text-red-700 font-bold cursor-pointer">
        Cambiar archivo
      </button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-center">
      <!-- Media Preview (Imagen o Video) -->
      <div class="relative w-full aspect-4/3 max-h-80 rounded-xl overflow-hidden shadow-md bg-black border border-slate-200 flex items-center justify-center">
        <img id="preview-image-element" src="" alt="Vista previa de foto" class="w-full h-full object-contain" />
        <video id="preview-video-element" src="" controls autoplay loop playsinline class="w-full h-full object-contain hidden"></video>
      </div>

      <!-- Envío Directo y Confirmación -->
      <div class="space-y-4">
        <div class="p-4 rounded-xl bg-blue-50/70 border border-blue-100 text-xs text-[#002855]">
          <p class="font-bold flex items-center gap-1.5 text-sm mb-1">
            <span class="w-2 h-2 rounded-full bg-[#00A3E0]"></span>
            Transmisión Instantánea
          </p>
          <p class="text-slate-600 leading-relaxed">
            Tu foto o clip corto de 8 segundos se proyectará en la pantalla gigante con reproducción automática.
          </p>
        </div>

        <!-- Botón de Envío Definitivo -->
        <button 
          type="button" 
          id="btn-confirm-upload" 
          class="w-full btn-bubble-senati text-white font-heading font-black text-base py-4 px-6 rounded-2xl uppercase tracking-wider flex items-center justify-center gap-2 cursor-pointer shadow-lg"
        >
          <span>Transmitir a la Pantalla Gigante</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import confetti from 'canvas-confetti';
  import { galleryStore } from '../lib/store';
  import { uploadMediaToSupabase } from '../lib/supabase';
  import type { MediaType } from '../lib/types';

  const methodsContainer = document.getElementById('upload-methods-container');
  const btnCamera = document.getElementById('btn-open-camera');
  const cameraFallbackInput = document.getElementById('camera-fallback-input') as HTMLInputElement;
  const fileGalleryInput = document.getElementById('file-gallery-input') as HTMLInputElement;

  const cameraModal = document.getElementById('camera-modal');
  const cameraVideo = document.getElementById('camera-video-feed') as HTMLVideoElement;
  const cameraCanvas = document.getElementById('camera-capture-canvas') as HTMLCanvasElement;
  const btnCloseCamera = document.getElementById('btn-close-camera');
  const btnSnap = document.getElementById('btn-snap-photo');
  const btnRecord = document.getElementById('btn-record-video');
  const btnRecordLabel = document.getElementById('btn-record-label');
  const countdownOverlay = document.getElementById('countdown-overlay');
  const countdownSeconds = document.getElementById('countdown-seconds');

  const previewPanel = document.getElementById('preview-panel');
  const previewImg = document.getElementById('preview-image-element') as HTMLImageElement;
  const previewVideo = document.getElementById('preview-video-element') as HTMLVideoElement;
  const previewTitle = document.getElementById('preview-title');
  const btnDiscard = document.getElementById('btn-discard-preview');
  const btnConfirm = document.getElementById('btn-confirm-upload');

  let mediaStream: MediaStream | null = null;
  let mediaRecorder: MediaRecorder | null = null;
  let recordedChunks: Blob[] = [];
  let recordTimer: any = null;
  let secondsRemaining = 8;

  let currentFile: File | Blob | null = null;
  let currentMediaUrl: string | null = null;
  let currentMediaType: MediaType = 'image';
  let currentSource: 'camera' | 'upload' = 'upload';
  let videoDuration: number | undefined = undefined;

  // File Selection (Photos & Videos)
  fileGalleryInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    currentFile = file;

    const isVideo = file.type.startsWith('video/');

    if (isVideo) {
      // Validate video length (max ~8.5 seconds)
      const videoElement = document.createElement('video');
      videoElement.preload = 'metadata';
      videoElement.src = URL.createObjectURL(file);
      videoElement.onloadedmetadata = () => {
        URL.revokeObjectURL(videoElement.src);
        const duration = videoElement.duration;
        if (duration > 8.5) {
          alert(`El video seleccionado dura ${Math.round(duration)} segundos. Por favor selecciona o recorta un clip de máximo 8 segundos.`);
          if (fileGalleryInput) fileGalleryInput.value = '';
          currentFile = null;
          return;
        }

        const reader = new FileReader();
        reader.onload = (event) => {
          currentMediaUrl = event.target?.result as string;
          currentMediaType = 'video';
          currentSource = 'upload';
          videoDuration = duration;
          showPreview();
        };
        reader.readAsDataURL(file);
      };
    } else {
      const reader = new FileReader();
      reader.onload = (event) => {
        currentMediaUrl = event.target?.result as string;
        currentMediaType = 'image';
        currentSource = 'upload';
        videoDuration = undefined;
        showPreview();
      };
      reader.readAsDataURL(file);
    }
  });

  // Mobile fallback input
  cameraFallbackInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    currentFile = file;
    const isVideo = file.type.startsWith('video/');
    const reader = new FileReader();
    reader.onload = (event) => {
      currentMediaUrl = event.target?.result as string;
      currentMediaType = isVideo ? 'video' : 'image';
      currentSource = 'camera';
      showPreview();
    };
    reader.readAsDataURL(file);
  });

  // Open Camera
  btnCamera?.addEventListener('click', async () => {
    if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
      try {
        mediaStream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: 'environment', width: { ideal: 1280 }, height: { ideal: 960 } },
          audio: true // Enabled for 8s short video clips
        });
        if (cameraVideo) {
          cameraVideo.srcObject = mediaStream;
          cameraVideo.play();
        }
        cameraModal?.classList.remove('hidden');
        methodsContainer?.classList.add('hidden');
      } catch (err) {
        console.warn('getUserMedia unavailable, using mobile capture input', err);
        cameraFallbackInput?.click();
      }
    } else {
      cameraFallbackInput?.click();
    }
  });

  function stopCamera() {
    stopRecording();
    if (mediaStream) {
      mediaStream.getTracks().forEach((track) => track.stop());
      mediaStream = null;
    }
    cameraModal?.classList.add('hidden');
    methodsContainer?.classList.remove('hidden');
  }

  btnCloseCamera?.addEventListener('click', stopCamera);

  // Snap Single Photo
  btnSnap?.addEventListener('click', () => {
    if (!cameraVideo || !cameraCanvas) return;
    const w = cameraVideo.videoWidth || 640;
    const h = cameraVideo.videoHeight || 480;
    cameraCanvas.width = w;
    cameraCanvas.height = h;

    const ctx = cameraCanvas.getContext('2d');
    if (ctx) {
      ctx.drawImage(cameraVideo, 0, 0, w, h);
      currentMediaUrl = cameraCanvas.toDataURL('image/jpeg', 0.9);
      cameraCanvas.toBlob((blob) => {
        if (blob) {
          currentFile = new File([blob], `photo_${Date.now()}.jpg`, { type: 'image/jpeg' });
        }
      }, 'image/jpeg', 0.9);
      currentMediaType = 'image';
      currentSource = 'camera';
      videoDuration = undefined;
      stopCamera();
      showPreview();
    }
  });

  // Record 8-Second Video
  btnRecord?.addEventListener('click', () => {
    if (mediaRecorder && mediaRecorder.state === 'recording') {
      stopRecording();
      return;
    }
    startRecording();
  });

  function startRecording() {
    if (!mediaStream) return;
    recordedChunks = [];
    secondsRemaining = 8;

    try {
      mediaRecorder = new MediaRecorder(mediaStream, { mimeType: 'video/webm' });
    } catch {
      mediaRecorder = new MediaRecorder(mediaStream);
    }

    mediaRecorder.ondataavailable = (e) => {
      if (e.data.size > 0) recordedChunks.push(e.data);
    };

    mediaRecorder.onstop = () => {
      const blob = new Blob(recordedChunks, { type: 'video/webm' });
      currentFile = new File([blob], `video_${Date.now()}.webm`, { type: 'video/webm' });
      const reader = new FileReader();
      reader.onload = (e) => {
        currentMediaUrl = e.target?.result as string;
        currentMediaType = 'video';
        currentSource = 'camera';
        videoDuration = 8 - secondsRemaining;
        stopCamera();
        showPreview();
      };
      reader.readAsDataURL(blob);
    };

    mediaRecorder.start();
    countdownOverlay?.classList.remove('hidden');
    if (btnRecordLabel) btnRecordLabel.textContent = 'Detener grabación';

    recordTimer = setInterval(() => {
      secondsRemaining--;
      if (countdownSeconds) countdownSeconds.textContent = String(secondsRemaining);
      if (secondsRemaining <= 0) {
        stopRecording();
      }
    }, 1000);
  }

  function stopRecording() {
    if (recordTimer) {
      clearInterval(recordTimer);
      recordTimer = null;
    }
    countdownOverlay?.classList.add('hidden');
    if (btnRecordLabel) btnRecordLabel.textContent = 'Grabar Video (8s)';
    if (mediaRecorder && mediaRecorder.state === 'recording') {
      mediaRecorder.stop();
    }
  }

  function showPreview() {
    if (!currentMediaUrl || !previewPanel) return;

    if (currentMediaType === 'video') {
      if (previewImg) previewImg.classList.add('hidden');
      if (previewVideo) {
        previewVideo.classList.remove('hidden');
        previewVideo.src = currentMediaUrl;
      }
      if (previewTitle) previewTitle.textContent = 'Vista Previa de Video Corto (8s)';
    } else {
      if (previewVideo) previewVideo.classList.add('hidden');
      if (previewImg) {
        previewImg.classList.remove('hidden');
        previewImg.src = currentMediaUrl;
      }
      if (previewTitle) previewTitle.textContent = 'Vista Previa de Fotografía';
    }

    previewPanel.classList.remove('hidden');
    methodsContainer?.classList.add('hidden');
  }

  btnDiscard?.addEventListener('click', () => {
    currentMediaUrl = null;
    currentFile = null;
    previewPanel?.classList.add('hidden');
    methodsContainer?.classList.remove('hidden');
    if (previewVideo) previewVideo.pause();
    if (fileGalleryInput) fileGalleryInput.value = '';
    if (cameraFallbackInput) cameraFallbackInput.value = '';
  });

  // Confirm and Transmit to Supabase and Gallery
  btnConfirm?.addEventListener('click', async () => {
    if (!currentMediaUrl && !currentFile) return;

    if (btnConfirm) {
      btnConfirm.innerHTML = `
        <svg class="animate-spin -ml-1 mr-2 h-5 w-5 text-white inline" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
        </svg>
        <span>Subiendo a la nube de Supabase...</span>
      `;
      (btnConfirm as HTMLButtonElement).disabled = true;
    }

    const session = galleryStore.getSession();
    const userId = session?.email || session?.phone || session?.name || 'Asistente SENATI';

    let finalUrl = currentMediaUrl;
    let finalId: string | undefined = undefined;

    // 1. Subir archivo a Supabase Storage y registrar en la BD
    if (currentFile) {
      try {
        const uploadResult = await uploadMediaToSupabase(
          currentFile,
          userId,
          currentMediaType,
          videoDuration
        );

        if (uploadResult && uploadResult.publicUrl) {
          finalUrl = uploadResult.publicUrl;
          finalId = uploadResult.dbId;
        }
      } catch (err: any) {
        console.warn('Advertencia durante subida a Supabase:', err);
        // Si falló la subida remota (por falta de bucket o políticas RLS en Supabase),
        // guardamos la foto localmente para no frustrar al usuario, pero le avisamos.
        if (err?.message?.includes('Bucket not found') || err?.message?.includes('row-level security') || err?.message?.includes('Storage:')) {
          alert('⚠️ Aviso: La foto se guardó localmente. Para que todos los dispositivos la vean en la nube, debes crear el bucket "event-media" y habilitar las políticas en Supabase SQL Editor.');
        }
      }
    }

    // 2. Agregar a la tienda local (y propagar por realtime a la pantalla gigante)
    galleryStore.addPhoto({
      id: finalId,
      url: finalUrl!,
      mediaType: currentMediaType,
      durationSeconds: videoDuration,
      source: currentSource
    });

    try {
      confetti({
        particleCount: 60,
        spread: 80,
        origin: { y: 0.6 }
      });
    } catch {}

    // 3. Limpiar estado
    currentMediaUrl = null;
    currentFile = null;
    if (fileGalleryInput) fileGalleryInput.value = '';
    if (cameraFallbackInput) cameraFallbackInput.value = '';
    if (previewVideo) previewVideo.pause();
    previewPanel?.classList.add('hidden');
    methodsContainer?.classList.remove('hidden');

    if (btnConfirm) {
      (btnConfirm as HTMLButtonElement).disabled = false;
      btnConfirm.innerHTML = `
        <span>Transmitir a la Pantalla Gigante</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      `;
    }

    const feed = document.getElementById('photo-wall-grid');
    feed?.scrollIntoView({ behavior: 'smooth' });
  });
</script>
