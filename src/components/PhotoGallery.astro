---
// PhotoGallery.astro
---

<div class="w-full">
  <!-- Bar de Título y Filtros -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
    <div>
      <h3 class="font-heading font-black text-2xl text-[#002855] flex items-center gap-2">
        <span>Muro del Evento en Vivo</span>
        <!-- Badge de conteo (trigger secreto: 7 clics para abrir panel admin) -->
        <span id="gallery-count-badge" class="text-xs bg-[#00A3E0]/15 text-[#002855] px-2.5 py-1 rounded-full font-bold cursor-default select-none">
          0 fotos
        </span>
      </h3>
      <p class="text-xs sm:text-sm text-slate-500">Fotografías y videos cortos transmitidos en directo a la pantalla gigante</p>
    </div>

    <!-- Filtros y Opciones Rápidas -->
    <div class="flex items-center gap-2">
      <!-- Botón Admin (solo visible en modo admin) -->
      <button 
        id="btn-admin-panel"
        class="hidden text-[11px] font-semibold px-2.5 py-1.5 rounded-xl bg-red-50 hover:bg-red-100 text-red-600 border border-red-200 transition-all cursor-pointer flex items-center gap-1"
        title="Panel Admin"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        <span>Admin</span>
      </button>
      <button 
        id="btn-sort-recent" 
        class="text-xs font-bold px-3 py-1.5 rounded-xl bg-[#002855] text-white shadow-sm transition-all cursor-pointer"
      >
        Más Recientes
      </button>
      <button 
        id="btn-sort-popular" 
        class="text-xs font-bold px-3 py-1.5 rounded-xl bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 transition-all cursor-pointer"
      >
        Más Populares ❤️
      </button>
      <button 
        id="btn-sync-gallery" 
        class="text-[11px] font-semibold px-2.5 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 transition-all cursor-pointer flex items-center gap-1"
        title="Actualizar fotos desde la base de datos"
      >
        <svg class="w-3.5 h-3.5 text-[#00A3E0]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
        <span>Sincronizar</span>
      </button>
    </div>
  </div>

  <!-- Modal PIN Admin (oculto por defecto) -->
  <div id="admin-pin-modal" class="fixed inset-0 z-[200] hidden bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl p-8 max-w-sm w-full shadow-2xl border border-slate-200 relative">
      <div class="flex flex-col items-center gap-4">
        <div class="w-14 h-14 rounded-2xl bg-red-50 border border-red-200 flex items-center justify-center">
          <svg class="w-7 h-7 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        </div>
        <h3 class="font-heading font-black text-xl text-slate-800">Acceso Admin</h3>
        <p class="text-sm text-slate-500 text-center">Ingresa el PIN para gestionar el contenido del evento</p>
        <input 
          id="admin-pin-input" 
          type="password" 
          maxlength="4"
          placeholder="••••"
          class="w-full text-center text-2xl tracking-[0.5em] font-black border-2 border-slate-200 rounded-2xl p-4 focus:border-red-400 focus:outline-none transition-colors"
        />
        <p id="admin-pin-error" class="text-xs text-red-500 hidden">PIN incorrecto. Inténtalo de nuevo.</p>
        <div class="flex gap-3 w-full">
          <button id="btn-cancel-pin" class="flex-1 py-3 rounded-2xl border border-slate-200 text-slate-600 font-bold text-sm hover:bg-slate-50 transition-colors cursor-pointer">Cancelar</button>
          <button id="btn-confirm-pin" class="flex-1 py-3 rounded-2xl bg-red-600 text-white font-bold text-sm hover:bg-red-700 transition-colors cursor-pointer">Ingresar</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Panel Admin flotante (visible solo en modo admin) -->
  <div id="admin-floating-bar" class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-[150] bg-red-700 text-white rounded-2xl px-5 py-3 shadow-2xl flex items-center gap-4 border border-red-500">
    <div class="flex items-center gap-2">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
      <span class="font-bold text-sm">Modo Admin Activo</span>
    </div>
    <div class="h-5 w-px bg-red-500"></div>
    <button id="btn-toggle-transmission" class="text-xs font-bold px-3 py-1.5 rounded-xl bg-white/20 hover:bg-white/30 transition-all cursor-pointer flex items-center gap-1.5" title="Finalizar o reactivar la transmisión de fotos">
      <span id="trans-btn-dot" class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span id="trans-btn-label">Finalizar Evento</span>
    </button>
    <div class="h-5 w-px bg-red-500"></div>
    <button id="btn-clear-cache" class="text-xs font-bold px-3 py-1.5 rounded-xl bg-white/20 hover:bg-white/30 transition-all cursor-pointer flex items-center gap-1.5">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
      Limpiar Caché
    </button>
    <button id="btn-exit-admin" class="text-xs font-bold px-3 py-1.5 rounded-xl bg-white/20 hover:bg-white/30 transition-all cursor-pointer">
      ✕ Salir
    </button>
  </div>

  <!-- Grid Responsivo de Fotos y Videos (Sin nombres ni mensajes) -->
  <div 
    id="photo-wall-grid" 
    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
  >
    <!-- Dynamic Cards Injected via JS -->
  </div>

  <!-- Estado Vacío -->
  <div id="gallery-empty-state" class="hidden text-center py-16 bg-white rounded-3xl border border-slate-200 p-8">
    <div class="w-16 h-16 rounded-2xl bg-sky-50 text-[#00A3E0] flex items-center justify-center mx-auto mb-4">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
      </svg>
    </div>
    <h4 class="font-heading font-bold text-slate-800 text-lg mb-1">Aún no hay fotos o videos en este evento</h4>
    <p class="text-xs text-slate-500 max-w-sm mx-auto">Sé el primero en tomar una foto o grabar un video corto de 8 segundos para verlo aquí y en la pantalla.</p>
  </div>

  <!-- Lightbox Modal para Ver Foto o Video en Detalle -->
  <div id="photo-modal" class="fixed inset-0 z-50 hidden bg-black/90 backdrop-blur-md flex items-center justify-center p-4">
    <div class="relative max-w-4xl w-full bg-slate-900 rounded-3xl overflow-hidden border border-white/20 shadow-2xl flex flex-col">
      <button id="btn-close-modal" class="absolute top-4 right-4 z-20 w-10 h-10 rounded-full bg-black/60 text-white hover:bg-black flex items-center justify-center cursor-pointer">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>

      <div class="max-h-[75vh] bg-black flex items-center justify-center overflow-hidden">
        <img id="modal-img" src="" alt="Detalle" class="w-full h-full object-contain" />
        <video id="modal-video" src="" controls autoplay loop playsinline class="w-full h-full object-contain hidden"></video>
      </div>

      <div class="p-5 bg-slate-900 text-white flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-[#002855] border border-white/20 flex items-center justify-center">
            <svg viewBox="0 0 100 100" class="w-5 h-5 fill-white">
              <rect width="100" height="100" rx="16" fill="#002855"/>
              <path d="M22 30h56v10H22zM22 46h40v10H22zM22 62h56v10H22z" fill="#00A3E0"/>
            </svg>
          </div>
          <div>
            <h4 class="font-heading font-extrabold text-base text-white">SENATI TEC 2026</h4>
            <span id="modal-photo-time" class="text-xs text-slate-400"></span>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button id="modal-btn-like" class="flex items-center gap-2 px-4 py-2 rounded-2xl bg-white/10 hover:bg-pink-600/30 text-pink-400 font-bold transition-all cursor-pointer">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
            <span id="modal-likes-count">0</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { galleryStore } from '../lib/store';
  import type { PhotoItem } from '../lib/types';

  const grid = document.getElementById('photo-wall-grid');
  const emptyState = document.getElementById('gallery-empty-state');
  const countBadge = document.getElementById('gallery-count-badge');
  const btnSortRecent = document.getElementById('btn-sort-recent');
  const btnSortPopular = document.getElementById('btn-sort-popular');
  const btnResetDemo = document.getElementById('btn-reset-demo');

  // Modal elements
  const modal = document.getElementById('photo-modal');
  const modalImg = document.getElementById('modal-img') as HTMLImageElement;
  const modalVideo = document.getElementById('modal-video') as HTMLVideoElement;
  const modalPhotoTime = document.getElementById('modal-photo-time');
  const modalLikesCount = document.getElementById('modal-likes-count');
  const modalBtnLike = document.getElementById('modal-btn-like');
  const btnCloseModal = document.getElementById('btn-close-modal');

  // Admin mode elements
  const adminPinModal = document.getElementById('admin-pin-modal');
  const adminPinInput = document.getElementById('admin-pin-input') as HTMLInputElement;
  const adminPinError = document.getElementById('admin-pin-error');
  const btnCancelPin = document.getElementById('btn-cancel-pin');
  const btnConfirmPin = document.getElementById('btn-confirm-pin');
  const adminFloatingBar = document.getElementById('admin-floating-bar');
  const btnClearCache = document.getElementById('btn-clear-cache');
  const btnExitAdmin = document.getElementById('btn-exit-admin');
  const btnAdminPanel = document.getElementById('btn-admin-panel');

  const ADMIN_PIN = '2026'; // PIN secreto
  let isAdminMode = false;
  let badgeClickCount = 0;
  let badgeClickTimer: ReturnType<typeof setTimeout> | null = null;

  // Trigger secreto: 7 clics en el badge de conteo
  countBadge?.addEventListener('click', () => {
    badgeClickCount++;
    if (badgeClickTimer) clearTimeout(badgeClickTimer);
    badgeClickTimer = setTimeout(() => { badgeClickCount = 0; }, 2000);
    if (badgeClickCount >= 7) {
      badgeClickCount = 0;
      openPinModal();
    }
  });

  function openPinModal() {
    if (adminPinModal) {
      adminPinInput.value = '';
      adminPinError?.classList.add('hidden');
      adminPinModal.classList.remove('hidden');
      adminPinModal.classList.add('flex');
      setTimeout(() => adminPinInput.focus(), 100);
    }
  }

  function closePinModal() {
    adminPinModal?.classList.add('hidden');
    adminPinModal?.classList.remove('flex');
  }

  function activateAdminMode() {
    isAdminMode = true;
    adminFloatingBar?.classList.remove('hidden');
    adminFloatingBar?.classList.add('flex');
    btnAdminPanel?.classList.remove('hidden');
    closePinModal();
    renderGallery();
  }

  function deactivateAdminMode() {
    isAdminMode = false;
    adminFloatingBar?.classList.add('hidden');
    adminFloatingBar?.classList.remove('flex');
    btnAdminPanel?.classList.add('hidden');
    renderGallery();
  }

  btnCancelPin?.addEventListener('click', closePinModal);
  adminPinModal?.addEventListener('click', (e) => {
    if (e.target === adminPinModal) closePinModal();
  });

  adminPinInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') verifyPin();
  });

  btnConfirmPin?.addEventListener('click', verifyPin);

  function verifyPin() {
    const entered = adminPinInput?.value?.trim();
    if (entered === ADMIN_PIN) {
      activateAdminMode();
    } else {
      adminPinError?.classList.remove('hidden');
      adminPinInput.value = '';
      adminPinInput.classList.add('border-red-400');
      setTimeout(() => adminPinInput.classList.remove('border-red-400'), 1000);
    }
  }

  btnAdminPanel?.addEventListener('click', openPinModal);
  btnExitAdmin?.addEventListener('click', deactivateAdminMode);

  // ── Botón Admin: Finalizar o Reactivar Transmisión ──
  const btnToggleTrans = document.getElementById('btn-toggle-transmission');
  const transBtnDot = document.getElementById('trans-btn-dot');
  const transBtnLabel = document.getElementById('trans-btn-label');

  function updateAdminTransBtn() {
    const isLive = galleryStore.isTransmissionActive();
    if (transBtnDot && transBtnLabel) {
      if (isLive) {
        transBtnDot.className = 'w-2 h-2 rounded-full bg-red-400 animate-ping';
        transBtnLabel.textContent = '⏹️ Finalizar Transmisión';
      } else {
        transBtnDot.className = 'w-2 h-2 rounded-full bg-emerald-400 animate-pulse';
        transBtnLabel.textContent = '▶️ Reactivar Transmisión';
      }
    }
  }

  btnToggleTrans?.addEventListener('click', async () => {
    const isCurrentlyLive = galleryStore.isTransmissionActive();
    const actionMsg = isCurrentlyLive
      ? '¿Estás seguro de FINALIZAR la transmisión del evento?\n\nLos asistentes ya NO podrán subir fotos ni videos nuevos.'
      : '¿Deseas REACTIVAR la transmisión del evento para permitir que los asistentes suban fotos y videos?';

    if (!confirm(actionMsg)) return;

    await galleryStore.setTransmissionActive(!isCurrentlyLive);
    updateAdminTransBtn();
    alert(!isCurrentlyLive ? '✅ Transmisión reactivada con éxito.' : '⏹️ Transmisión finalizada. Las subidas han sido cerradas.');
  });

  updateAdminTransBtn();
  galleryStore.subscribe((e) => {
    if (e.type === 'TRANSMISSION_STATUS_CHANGED') {
      updateAdminTransBtn();
    }
  });

  btnClearCache?.addEventListener('click', async () => {
    if (!confirm('¿Limpiar caché local y recargar desde la base de datos?')) return;
    // Borrar localStorage completamente
    localStorage.clear();
    // Recargar desde Supabase
    await galleryStore.syncWithSupabase();
    alert('✅ Caché limpiada. Galería actualizada desde la base de datos.');
    renderGallery();
  });

  let currentPhotos: PhotoItem[] = [];
  let sortMode: 'recent' | 'popular' = 'recent';
  let activeModalPhotoId: string | null = null;

  function formatTime(timestamp: number) {
    const diffSec = Math.floor((Date.now() - timestamp) / 1000);
    if (diffSec < 60) return 'Hace unos segundos';
    const diffMin = Math.floor(diffSec / 60);
    if (diffMin < 60) return `Hace ${diffMin}m`;
    const diffHours = Math.floor(diffMin / 60);
    if (diffHours < 24) return `Hace ${diffHours}h`;
    return new Date(timestamp).toLocaleDateString('es-PE', { day: '2-digit', month: 'short' });
  }

  function renderGallery() {
    if (!grid) return;

    currentPhotos = galleryStore.getPhotos();
    if (sortMode === 'popular') {
      currentPhotos.sort((a, b) => b.likes - a.likes);
    } else {
      currentPhotos.sort((a, b) => b.timestamp - a.timestamp);
    }

    if (countBadge) {
      countBadge.textContent = `${currentPhotos.length} fotos y videos`;
    }

    if (currentPhotos.length === 0) {
      grid.classList.add('hidden');
      emptyState?.classList.remove('hidden');
      return;
    }

    grid.classList.remove('hidden');
    emptyState?.classList.add('hidden');
    grid.innerHTML = '';

    currentPhotos.forEach((photo) => {
      const isLiked = galleryStore.isPhotoLiked(photo.id);
      const isVideo = photo.mediaType === 'video';
      const isOwner = galleryStore.isUserPhotoOwner(photo);
      const card = document.createElement('div');
      card.className = 'group bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-slate-100 flex flex-col';

      let poster = photo.thumbnailUrl;
      if (isVideo && !poster && photo.url && photo.url.includes('cloudinary.com')) {
        poster = photo.url.replace(/\.[a-zA-Z0-9]+$/, '.jpg');
      }

      card.innerHTML = `
        <!-- Header de la foto/video -->
        <div class="p-3.5 flex items-center justify-between border-b border-slate-100">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full ${isVideo ? 'bg-[#7C3AED]' : 'bg-[#00A3E0]'}"></span>
            <span class="text-xs font-bold text-[#002855]">${isVideo ? 'Video Clip (8s)' : 'Foto del Evento'}</span>
            <span class="text-[11px] text-slate-400 font-medium">· ${formatTime(photo.timestamp)}</span>
          </div>
          <div class="flex items-center gap-1.5">
            ${isOwner ? `
              <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-cyan-50 text-cyan-700 border border-cyan-200">
                Tu publicación
              </span>
            ` : ''}
            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full ${
              isVideo 
                ? 'bg-purple-100 text-[#7C3AED]' 
                : (photo.source === 'camera' ? 'bg-sky-100 text-[#00A3E0]' : 'bg-slate-100 text-slate-600')
            }">
              ${isVideo ? '🎥 Video 8s' : (photo.source === 'camera' ? '📷 Cámara' : '🖼️ Galería')}
            </span>
          </div>
        </div>

        <!-- Vista previa de Media -->
        <div class="relative aspect-4/3 overflow-hidden bg-black cursor-pointer">
          ${isVideo ? `
            <video src="${photo.url}#t=0.001" ${poster ? `poster="${poster}"` : ''} preload="metadata" muted loop playsinline class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"></video>
            <div class="absolute top-2.5 right-2.5 bg-black/80 backdrop-blur-xs text-white text-[10px] font-black px-2 py-0.5 rounded-full flex items-center gap-1 shadow">
              <span class="w-1.5 h-1.5 rounded-full bg-red-400 animate-pulse"></span>
              8s
            </div>
          ` : `
            <img 
              src="${photo.url}" 
              alt="Foto SENATI TEC" 
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          `}
          <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
            <span class="bg-white/90 text-slate-900 text-xs font-bold px-3 py-1.5 rounded-full shadow-md backdrop-blur-xs flex items-center gap-1.5">
              ${isVideo ? '▶ Reproducir Video' : 'Ver en grande'}
            </span>
          </div>
        </div>

        <!-- Footer con botón de Like y Botón de Eliminar (SOLO para el autor) -->
        <div class="p-3.5 flex items-center justify-between bg-slate-50/50 gap-2">
          <button 
            type="button" 
            data-like-btn="${photo.id}"
            class="flex items-center gap-2 text-xs font-bold py-1.5 px-3 rounded-full transition-all cursor-pointer ${
              isLiked 
                ? 'bg-pink-50 text-pink-600 border border-pink-200' 
                : 'bg-white hover:bg-slate-100 text-slate-600 border border-slate-200'
            }"
          >
            <svg class="w-4 h-4 ${isLiked ? 'fill-pink-500 text-pink-500' : 'text-slate-400'}" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
            <span data-likes-counter="${photo.id}">${photo.likes}</span>
            <span>${photo.likes === 1 ? 'Me gusta' : 'Me gustas'}</span>
          </button>

          <div class="flex items-center gap-2">
            <span class="text-[11px] font-bold text-emerald-600 flex items-center gap-1.5 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              En Pantalla
            </span>
            ${isAdminMode ? `
              <button 
                data-admin-delete="${photo.id}"
                class="flex items-center gap-1 text-[10px] font-bold px-2 py-1 rounded-full bg-red-600 text-white hover:bg-red-700 transition-all cursor-pointer border-0"
                title="Eliminar foto (admin)"
              >
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                Eliminar
              </button>
            ` : ''}
          </div>
        </div>
      `;

      const imgWrapper = card.querySelector('.aspect-4\\/3');
      imgWrapper?.addEventListener('click', () => {
        openModal(photo);
      });

      const likeBtn = card.querySelector(`[data-like-btn="${photo.id}"]`);
      likeBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        galleryStore.toggleLike(photo.id);
        renderGallery();
      });

      // Botón eliminar admin
      const adminDeleteBtn = card.querySelector(`[data-admin-delete="${photo.id}"]`);
      adminDeleteBtn?.addEventListener('click', async (e) => {
        e.stopPropagation();
        const isVideo = photo.mediaType === 'video';
        if (!confirm(`¿Eliminar este ${isVideo ? 'video' : 'foto'} de la galería? Esta acción no se puede deshacer.`)) return;
        adminDeleteBtn.textContent = '...';
        (adminDeleteBtn as HTMLButtonElement).disabled = true;
        const ok = galleryStore.deletePhoto(photo.id);
        if (ok) {
          card.style.transition = 'opacity 0.3s';
          card.style.opacity = '0';
          setTimeout(() => { card.remove(); renderGallery(); }, 350);
        } else {
          alert('Error al eliminar. Intenta de nuevo.');
          (adminDeleteBtn as HTMLButtonElement).disabled = false;
        }
      });

      // Detección de fotos eliminadas directamente del storage de Supabase (error 404)
      const mediaImg = card.querySelector('img');
      mediaImg?.addEventListener('error', () => {
        card.remove();
        galleryStore.removeGhostPhoto(photo.id);
      });
      const mediaVid = card.querySelector('video');
      mediaVid?.addEventListener('error', () => {
        card.remove();
        galleryStore.removeGhostPhoto(photo.id);
      });

      grid.appendChild(card);
    });
  }

  function openModal(photo: PhotoItem) {
    activeModalPhotoId = photo.id;

    if (photo.mediaType === 'video') {
      if (modalImg) modalImg.classList.add('hidden');
      if (modalVideo) {
        modalVideo.classList.remove('hidden');
        modalVideo.src = photo.url;
        modalVideo.currentTime = 0;
        modalVideo.play().catch(() => {});
      }
    } else {
      if (modalVideo) {
        modalVideo.pause();
        modalVideo.classList.add('hidden');
      }
      if (modalImg) {
        modalImg.classList.remove('hidden');
        modalImg.src = photo.url;
      }
    }

    if (modalPhotoTime) modalPhotoTime.textContent = formatTime(photo.timestamp);
    if (modalLikesCount) modalLikesCount.textContent = String(photo.likes);
    modal?.classList.remove('hidden');
  }

  function closeModal() {
    activeModalPhotoId = null;
    if (modalVideo) modalVideo.pause();
    modal?.classList.add('hidden');
  }

  btnCloseModal?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  modalBtnLike?.addEventListener('click', () => {
    if (!activeModalPhotoId) return;
    const newLikes = galleryStore.toggleLike(activeModalPhotoId);
    if (modalLikesCount) modalLikesCount.textContent = String(newLikes);
    renderGallery();
  });

  btnSortRecent?.addEventListener('click', () => {
    sortMode = 'recent';
    btnSortRecent.className = 'text-xs font-bold px-3 py-1.5 rounded-xl bg-[#002855] text-white shadow-sm transition-all cursor-pointer';
    if (btnSortPopular) btnSortPopular.className = 'text-xs font-bold px-3 py-1.5 rounded-xl bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 transition-all cursor-pointer';
    renderGallery();
  });

  btnSortPopular?.addEventListener('click', () => {
    sortMode = 'popular';
    if (btnSortPopular) btnSortPopular.className = 'text-xs font-bold px-3 py-1.5 rounded-xl bg-[#002855] text-white shadow-sm transition-all cursor-pointer';
    if (btnSortRecent) btnSortRecent.className = 'text-xs font-bold px-3 py-1.5 rounded-xl bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 transition-all cursor-pointer';
    renderGallery();
  });

  const btnSyncGallery = document.getElementById('btn-sync-gallery');
  btnSyncGallery?.addEventListener('click', async () => {
    btnSyncGallery.classList.add('opacity-50');
    await galleryStore.syncWithSupabase();
    setTimeout(() => btnSyncGallery.classList.remove('opacity-50'), 600);
  });

  galleryStore.subscribe(() => {
    renderGallery();
  });

  renderGallery();
</script>
