---
import '../styles/global.css';
import senatiSymbol from '../assets/Senati-Symbol.png';

interface Props {
  title?: string;
  description?: string;
  hideNav?: boolean;
}

const { 
  title = "SENATI Event Live Gallery - Transmisión y Fotos en Vivo",
  description = "Plataforma interactiva para eventos de SENATI: sube fotos desde tu móvil y visualízalas en pantalla gigante en tiempo real.",
  hideNav = false
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="es" class="h-full bg-slate-50 antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={`${base}/Senati-Symbol.png`} />
    <link rel="shortcut icon" type="image/png" href={`${base}/Senati-Symbol.png`} />
    <link rel="apple-touch-icon" href={`${base}/Senati-Symbol.png`} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    
    <!-- Google Fonts: Inter & Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <title>{title}</title>
    <style>
      body {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      }
      h1, h2, h3, h4, .font-heading {
        font-family: 'Outfit', system-ui, -apple-system, sans-serif;
      }
    </style>
  </head>
  <body class="min-h-full flex flex-col text-slate-800">
    {!hideNav && (
      <header class="bg-[#002855] text-white sticky top-0 z-40 shadow-md border-b border-[#003875]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
          <a href={`${base}/`} class="flex items-center gap-3 group">
            <div class="w-11 h-11 rounded-2xl bg-white p-1 flex items-center justify-center shadow-md group-hover:scale-105 transition-transform overflow-hidden border border-white/20">
              <img src={senatiSymbol.src} alt="Logo SENATI" class="w-full h-full object-contain" />
            </div>
            <div>
              <div class="flex items-center gap-2">
                <span class="font-heading font-black tracking-wider text-xl text-white">SENATI</span>
                <span class="text-xs bg-[#00A3E0] text-white px-2 py-0.5 rounded-full font-bold uppercase tracking-wide">Live</span>
              </div>
              <p class="text-[10px] text-cyan-200 uppercase tracking-widest font-semibold">Event Gallery</p>
            </div>
          </a>

          <nav class="flex items-center gap-2 sm:gap-4">
            <a href={`${base}/login`} class="text-xs sm:text-sm font-semibold text-slate-200 hover:text-white px-3 py-1.5 rounded-lg hover:bg-white/10 transition-colors">
              Acceso
            </a>
            <a href={`${base}/galeria`} class="text-xs sm:text-sm font-semibold text-slate-200 hover:text-white px-3 py-1.5 rounded-lg hover:bg-white/10 transition-colors">
              Muro & Carga
            </a>
            <a href={`${base}/presentacion`} class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold bg-[#00A3E0] hover:bg-[#008cc2] text-white px-3.5 py-1.5 rounded-full shadow-sm hover:shadow transition-all">
              <span class="w-2 h-2 rounded-full bg-red-400 animate-ping"></span>
              <span>Modo Pantalla</span>
            </a>
          </nav>
        </div>
      </header>
    )}

    <main class="flex-1 flex flex-col">
      <slot />
    </main>
  </body>
</html>
